# Waitlist storage — pick ONE path (Turso preferred when available)

# A) Local libSQL file (dev / offline verification)
# TURSO_DATABASE_URL=file:./data/waitlist.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# B) Turso cloud (after: turso auth login && turso db create reinstate-waitlist)
# TURSO_DATABASE_URL=libsql://….turso.io
# TURSO_AUTH_TOKEN=…

# C) GitHub Gist fallback (used in production when Turso is not configured)
# Create a secret gist with waitlist.json content "[]", then:
WAITLIST_GIST_ID=
GITHUB_TOKEN=

# Optional — notify on signup (never required for waitlist success)
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
WAITLIST_FROM_EMAIL=Reinstate Waitlist <onboarding@resend.dev>
## Optional public search verification tokens. Prefer DNS domain verification
## when available; never put private API credentials in PUBLIC_* variables.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

## Optional server-only IndexNow ownership key. Provision this through the
## deployment secret store; never use a PUBLIC_* name or commit a real value.
INDEXNOW_KEY=

## Optional privacy-conscious analytics. Both values are required to load the
## script; leave blank to ship no analytics.
##
## Production sets the host to https://reinstate.dev/ingest, the first-party
## rewrite declared in vercel.json, so that content blockers do not drop
## events. Local development points at https://us.i.posthog.com directly,
## because the rewrite only exists on Vercel.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=
