# Waitlist storage — pick ONE path (Turso preferred when available)

# A) Local libSQL file (dev / offline verification)
# TURSO_DATABASE_URL=file:./data/waitlist.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# B) Turso cloud (after: turso auth login && turso db create reinstate-waitlist)
# TURSO_DATABASE_URL=libsql://….turso.io
# TURSO_AUTH_TOKEN=…

# C) GitHub Gist fallback (used in production when Turso is not configured)
# Create a secret gist with waitlist.json content "[]", then:
WAITLIST_GIST_ID=
GITHUB_TOKEN=

# Optional — notify on signup (never required for waitlist success)
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
WAITLIST_FROM_EMAIL=Reinstate Waitlist <onboarding@resend.dev>

# PostHog browser analytics
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
