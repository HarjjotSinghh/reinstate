# Waitlist storage — pick ONE path (Turso preferred when available)

# A) Local libSQL file (dev / offline verification)
# TURSO_DATABASE_URL=file:./data/waitlist.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# B) Turso cloud (after: turso auth login && turso db create reinstate-waitlist)
# TURSO_DATABASE_URL=libsql://….turso.io
# TURSO_AUTH_TOKEN=…

# C) GitHub Gist fallback (used in production when Turso is not configured)
# Create a secret gist with waitlist.json content "[]", then:
WAITLIST_GIST_ID=
GITHUB_TOKEN=

# Optional — notify on signup (never required for waitlist success)
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
WAITLIST_FROM_EMAIL=Reinstate Waitlist <onboarding@resend.dev>
## Optional public search verification tokens. Prefer DNS domain verification
## when available; never put private API credentials in PUBLIC_* variables.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

## Optional server-only IndexNow ownership key. Provision this through the
## deployment secret store; never use a PUBLIC_* name or commit a real value.
INDEXNOW_KEY=

## Optional privacy-conscious analytics. Leave the script URL blank to ship no
## analytics at all.
##
## PUBLIC_PLAUSIBLE_SCRIPT_URL is the only required value. Plausible's current
## tracker identifies the site by the script filename, so paste the URL from the
## snippet Plausible shows you, e.g.
##   https://plausible.io/js/pa-<siteId>.js
##
## PUBLIC_PLAUSIBLE_DOMAIN is optional and only used by Plausible's legacy
## script.js tracker, which identifies the site by a data-domain attribute.
## Setting it alongside the current tracker is harmless.
##
## Do not switch to an outbound-links or file-downloads script variant, and do
## not enable those in the Plausible dashboard: they transmit destination URLs as
## event properties, which the published privacy commitment does not allow. The
## site already reports outbound clicks through its own reviewed event taxonomy.
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_PLAUSIBLE_DOMAIN=
