<style>
  .problem-block {
    --sv-whiteboard: #f4f6ef;
    --sv-whiteboard-edge: #a6b090;
    --sv-whiteboard-ink: #1b2822;
    --sv-whiteboard-dim: #66736c;
    --sv-whiteboard-accent: #679c25;

    position: relative;
    scroll-margin-top: 4.5rem;
    overflow-x: clip;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    transition: background 0.3s ease, color 0.3s ease;

    /* THE FLOOR. The colour lives here; the grid is the coordinate-matched
       SVG layer above it so the hero/problem seam cannot drift. */
    background-color: var(--sv-floor);
  }

  .lede,
  .below {
    position: relative;
    z-index: 2;
  }
  .floor-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .floor-grid svg {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    fill: none;
    stroke: var(--sv-floorline);
    stroke-width: 1.5;
  }
  .scene {
    position: relative;
    z-index: 0;
    pointer-events: none;
  }

  /* ---------- lede ---------- */
  .lede {
    max-width: 88rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem) 1.5rem;
    text-align: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.36rem 0.85rem 0.36rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  h2 {
    margin: clamp(0.75rem, 1.6vw, 1.1rem) auto 0;
    max-width: min(44ch, 100%);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    font-weight: 400;
    text-wrap: balance;
  }

  .sub {
    margin: 1rem auto 0;
    max-width: 72ch;
    /* match hero .sub */
    font-size: clamp(1rem, 0.5vw + 0.92rem, 1.15rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--ink) 26%, var(--ink-2));
    text-wrap: pretty;
  }

  /* ---------- scene (transparent: the floor behind it is the page) ---------- */
  .scene {
    /* pulls the extended viewBox back up (80/1640 of width), then leaves
       ~18px under the lede so padding isn't eaten by the pull */
    margin: calc(-4.88% + 18px) 0 0;
    width: 100%;
