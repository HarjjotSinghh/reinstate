          {/* prongs: same rim as cable (core 2.6 + 4) */}
          <path d="M23 -4 H33 M23 4 H33" stroke={SK} stroke-width="6.6" stroke-linecap="round" />
          <path d="M23 -4 H33 M23 4 H33" stroke="var(--sv-dev-2)" stroke-width="2.6" stroke-linecap="round" />
        </g>

        {/* ---------- the coat stand, far left ---------- */}
        <g transform={`translate(${GX_COAT} ${GY_COAT}) scale(${S})`}>
          <polygon class="cast hard" points={csShadow} />
          <g class="unit furn">
            <polygon class="f-side" points={csBase.side} />
            <polygon class="f-front" points={csBase.front} />
            <polygon class="f-top" points={csBase.top} />
