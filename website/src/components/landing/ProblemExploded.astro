---
import { box, fmt, P } from '../../lib/iso';

/* The hero's floor, continued — literally. This whole block IS the floor:
   the background paints the same plane (same colour, same 30° grid, same
   pitch, phase-matched to the hero's SVG grid at the seam), and the problem
   heading now stands directly on that floor. The scene SVG is transparent
   and only carries the props, so the grid never breaks.

   The scenery is new, deeper into the office: the planning corner where the
   problem lives — a whiteboard of crossed-out workarounds, a bookcase of old
   backups, the couch corner, moving boxes, and the cable that tried to make
   it across the room and didn't. */

const foot = (x: number, y: number, z: number, w: number, d: number) =>
  fmt([P(x, y, z), P(x + w, y, z), P(x + w, y + d, z), P(x, y + d, z)]);

/* every prop group uses a local floor at z=0 and builds upward */
const S = 1.02; /* same scale as the hero, so furniture sizes agree */

/* The hero's grid uses 98-unit intercepts and a 947/1640 screen-space slope.
   This pattern keeps those exact coordinates past the SVG seam instead of
   restarting an independently phased CSS gradient. */
const GRID_PITCH = 98;
const GRID_SLOPE = 947 / 1640;
const GRID_TILE_W = GRID_PITCH / GRID_SLOPE;
const GRID_POS_WRAP_X = (GRID_PITCH - 20) / GRID_SLOPE;
const GRID_NEG_WRAP_X = 6 / GRID_SLOPE;

/* ---- the easel whiteboard: the plan that isn't working ---- */
const wbPanel = box(-130, -8, 60, 260, 16, 164);
const wbLegL = box(-108, -4, 0, 14, 12, 62);
const wbLegR = box(94, -4, 0, 14, 12, 62);
const wbLedge = box(-112, 8, 52, 224, 12, 9);
const wbShadow = foot(-130, -8, 0, 260, 16);
const wbLegShadows = [foot(-108, -4, 0, 14, 12), foot(94, -4, 0, 14, 12)];
const rug = foot(-190, -120, 0, 380, 240);
const rugInner = foot(-170, -100, 0, 340, 200);

/* ---- the bookcase: an open frame, tall airy rows, every book fits ----
   Rows: z 16–112 (books ≤58), z 122–210 (books ≤50), z 220–296 (items ≤44).
   Painter order matters: the right wall is closest to the viewer, so it is
   drawn AFTER the books — otherwise books on the right end paint over it.
   Right-end items keep a wide margin from the wall so nothing reads as
   puncturing the frame. */
const shelfBack = box(12, 2, 16, 206, 6, 280);
const shelfBase = box(12, 0, 0, 206, 64, 16);
const shelfWallL = box(0, 0, 0, 12, 64, 296);
const shelfWallR = box(218, 0, 0, 12, 64, 296);
const shelfSlabs = [box(12, 0, 112, 206, 64, 10), box(12, 0, 210, 206, 64, 10)];
const shelfTop = box(0, 0, 296, 230, 64, 10);
const shelfShadow = foot(0, 0, 0, 230, 64);
type Book = { x: number; z: number; w: number; h: number; tone: string };
const books: Book[] = [
  { x: 16, z: 16, w: 18, h: 56, tone: 'a' },
  { x: 36, z: 16, w: 14, h: 48, tone: 'd' },
  { x: 52, z: 16, w: 22, h: 58, tone: 'b' },
  { x: 76, z: 16, w: 16, h: 44, tone: 'c' },
  { x: 94, z: 16, w: 15, h: 52, tone: 'd' },
  { x: 138, z: 16, w: 20, h: 40, tone: 'b' },
  { x: 16, z: 122, w: 17, h: 46, tone: 'c' },
  { x: 35, z: 122, w: 19, h: 50, tone: 'a' },
  { x: 56, z: 122, w: 15, h: 42, tone: 'b' },
  { x: 16, z: 220, w: 20, h: 40, tone: 'd' },
  { x: 38, z: 220, w: 15, h: 34, tone: 'a' },
].map((b) => ({ ...b, g: box(b.x, 13, b.z, b.w, 38, b.h) }) as Book & { g: ReturnType<typeof box> });
/* two books lying flat, and the backup-drive graveyard */
const flatA = { tone: 'b', g: box(60, 12, 220, 44, 40, 8) };
const flatB = { tone: 'c', g: box(64, 14, 228, 38, 34, 8) };
const crate = box(120, 10, 122, 62, 44, 30);
const hdd = box(116, 14, 220, 50, 36, 20);
const hddLed = P(148, 50, 230);
const coilCenter = P(178, 32, 220);
const shelfPot = box(150, 16, 306, 32, 32, 22);
const shelfPotTop = P(166, 32, 328);

/* ---- the couch corner: back and arms share width, rear plane, and top ---- */
const couchBase = box(0, 0, 0, 240, 95, 38);
const couchBack = box(0, -18, 38, 240, 18, 60);
const couchArmL = box(0, 0, 38, 28, 95, 60);
const couchArmR = box(212, 0, 38, 28, 95, 60);
const cushionL = box(30, 8, 38, 88, 80, 16);
const cushionR = box(122, 8, 38, 88, 80, 16);
const couchShadow = foot(0, -18, 0, 240, 113);
const sideTable = box(262, 12, 0, 62, 62, 52);
const sideTableShadow = foot(262, 12, 0, 62, 62);
const mug = box(284, 26, 52, 18, 18, 17);
const mugHandle = P(302, 35, 62);

/* ---- the coffee table: pizza box, book stack, second mug ---- */
const ctTop = box(0, 0, 34, 150, 80, 10);
const ctLegs = [
  box(8, 8, 0, 8, 8, 34),
  box(134, 8, 0, 8, 8, 34),
  box(8, 64, 0, 8, 8, 34),
  box(134, 64, 0, 8, 8, 34),
];
const ctShadow = foot(0, 0, 0, 150, 80);
const pizza = box(18, 10, 44, 64, 52, 8);
const stackA = { tone: 'c', g: box(100, 14, 44, 40, 28, 6) };
const stackB = { tone: 'b', g: box(103, 16, 50, 34, 24, 6) };
const mug2 = box(112, 50, 44, 16, 16, 15);
const mug2Handle = P(128, 58, 52);

/* ---- the coat stand, just inside the room ---- */
const csBase = box(6, 6, 0, 48, 48, 8);
const csPole = box(26, 26, 8, 10, 10, 148);
const csPegR = box(36, 28, 92, 24, 7, 7);
const csPegL = box(12, 28, 140, 22, 7, 7);
const csPegY = box(28, 34, 124, 7, 24, 7);
const csKnob = box(27, 27, 156, 8, 8, 12);
const csShadow = foot(6, 6, 0, 48, 48);
const tote = box(24, 52, 86, 24, 13, 32);

/* ---- the moving boxes: "switching machines", packed ---- */
const mv1 = box(0, 0, 0, 96, 80, 62);
const mvTape1 = foot(40, 0, 62, 16, 80);
const mv2 = box(12, 8, 62, 72, 62, 46);
const mvTape2 = foot(38, 8, 108, 16, 62);
const mvShadow = foot(0, 0, 0, 96, 80);

/* ---- the snake plant ---- */
const pot2 = box(0, 0, 0, 62, 62, 56);
const pot2Shadow = foot(0, 0, 0, 62, 62);
const soil2 = P(31, 31, 56);

/* ---- failed drafts, dropped by the whiteboard (scene-absolute) ---- */
const papers = [
  { quad: foot(938, -100, 0, 24, 16), ink: 'M 894 416 L 912 422' },
  { quad: foot(1003, -95, 0, 20, 14), ink: 'M 944 450 L 960 457' },
  { quad: foot(981, -21, 0, 22, 15), ink: 'M 866 477 L 884 483' },
];

/* ---- group anchors on the floor ---- */
const GX_WB = 820;
const GY_WB = 300;
const GX_SHELF = 1290;
const GY_SHELF = 325;
const GX_COUCH = 330;
const GY_COUCH = 390;
const GX_CT = 450;
const GY_CT = 580;
const GX_PLANT = 1100;
const GY_PLANT = 440;
const GX_BOXES = 1240;
const GY_BOXES = 570;
const GX_COAT = 215;
const GY_COAT = 190;

const SK = 'var(--sv-stroke)';
const DIM = 'var(--sv-dim)';
const INK = 'var(--sv-ink)';
const PRIM_DEEP = 'var(--sv-prim-deep)';

/* ---- projected-text helpers (same 30° projector as lib/iso) ---- */
const CX = Math.cos(Math.PI / 6);
const m2 = (m: number[]) => `matrix(${m.map((n) => +n.toFixed(2)).join(' ')})`;
const frontText = (x: number, y: number, z: number, d: number, h: number) => {
  const [e, f] = P(x, y + d, z + h);
  return m2([CX, 0.5, 0, 1, e, f]);
};

/* The loose cable enters from the room above, settles into a broad floor
   curve, then ends at an ordinary unplugged connector near the couch. */
const cable =
  'M -12 -20 C 112 -30, 220 -10, 268 56 C 312 116, 336 208, 398 278 C 456 344, 524 386, 610 372';

const panels = [
  {
    kicker: 'before · without Reinstate',
    title: 'Context dies at the desk',
    good: false,
    items: [
      'Sessions trapped on one machine',
      'Paths and agent state drift apart',
      'Context must be rebuilt manually',
    ],
  },
  {
    kicker: 'after · with Reinstate',
    title: 'Portable state you control',
    good: true,
    items: [
      'Pull sessions onto another device',
      'Remap paths across macOS and Windows',
      'Store encrypted state in your own bucket',
    ],
  },
];

/* ---- card art: before — the state piles up on the machine ---- */
const cbMachine = box(0, 0, 0, 84, 56, 40);
const cbTrayA = box(14, 10, 40, 56, 38, 10);
const cbTrayB = box(16, 12, 50, 52, 34, 10);
const cbTrayC = box(18, 14, 60, 48, 30, 10);
const cbShadow = foot(0, 0, 0, 84, 56);
const cbLooseA = { tone: 'd', g: box(-52, -18, 0, 30, 22, 4) };
const cbLooseB = { tone: 'c', g: box(-44, -12, 4, 26, 18, 4) };
const cbDrive = box(-42, 18, 0, 22, 20, 18);
const cbDriveLed = P(-20, 38, 9);

/* ---- card art: after — the checkpoint, wired across ---- */
const caCube = box(0, 0, 0, 54, 54, 54);
const caShadow = foot(0, 0, 0, 54, 54);
const caLapDeck = box(92, 4, 0, 38, 30, 6);
const caLapLid = box(92, 2, 6, 38, 5, 28);
const caLapShadow = foot(92, 4, 0, 38, 30);
const caLapKeyboard = foot(98, 8, 6.2, 27, 11);
const caLapKeys = Array.from({ length: 3 }, (_, row) =>
  Array.from({ length: 4 }, (_, col) =>
    foot(99 + col * 6.2, 8.8 + row * 3.35, 6.4, 4.6, 2.25),
  ),
).flat();
const caLapTrackpad = foot(103, 21.5, 6.3, 17, 6.5);
const caPathA = { tone: 'd', g: box(58, 48, 0, 18, 12, 3) };
const caPathB = { tone: 'c', g: box(80, 50, 0, 16, 10, 3) };
const caStore = box(138, -18, 0, 22, 22, 22);
const caStoreLed = P(154, 4, 11);
---

<div class="problem-block" id="how">
  <div class="floor-grid" aria-hidden="true">
    <svg
      viewBox="0 856 1640 32000"
      preserveAspectRatio="xMinYMin slice"
      focusable="false"
    >
      <defs>
        <pattern
          id="continued-floor-grid"
          x="0"
          y="0"
          width={GRID_TILE_W}
          height={GRID_PITCH}
          patternUnits="userSpaceOnUse"
        >
          <path
            d={`M0 20 L${GRID_POS_WRAP_X} 98 M${GRID_POS_WRAP_X} 0 L${GRID_TILE_W} 20`}
          />
          <path
            d={`M0 6 L${GRID_NEG_WRAP_X} 0 M${GRID_NEG_WRAP_X} 98 L${GRID_TILE_W} 6`}
          />
        </pattern>
      </defs>
      <rect
        x="0"
        y="856"
        width="1640"
        height="32000"
        fill="url(#continued-floor-grid)"
        stroke="none"
      />
    </svg>
  </div>

  <section class="problem-section" id="problem" aria-labelledby="problem-title">
    <div class="lede">
      <span class="badge"><i aria-hidden="true"></i> 02:13 · the plan isn't working</span>
      <h2 id="problem-title">Git has the code and its history.<br />It does not have the conversation.</h2>
      <p class="sub">
        Git still handles your code. Reinstate carries the encrypted Claude Code and Codex
        session state Git leaves behind, remapping project paths for the machine you are on.
      </p>
    </div>

    <figure class="scene">
      {/* viewBox extends slightly upward for the cable's entry; the negative
          margin on .scene keeps the layout put */}
      <svg viewBox="0 -80 1640 825" role="img" aria-labelledby="ptitle pdesc" preserveAspectRatio="xMidYMax meet">
        <title id="ptitle">Deeper into the office: the planning corner</title>
        <desc id="pdesc">
          The floor from the hero scene continues into a corner of the office: an easel
          whiteboard covered in crossed-out workarounds — scp, Dropbox, rsync — a bookcase
          holding old backup drives, a couch with a coffee table and a warm mug, moving
          boxes, and a cable that snakes in from the desks above and ends unplugged in the
          middle of the floor.
        </desc>

        {/* ---------- the cable that tried: on the floor, below the furniture ---------- */}
        {/* black outline under grey core — rim = (11-7)/2 = 2 on each side */}
        <path
          d={cable}
          fill="none"
          stroke={SK}
          stroke-width="11"
          stroke-linecap="round"
        />
        <path
          d={cable}
          fill="none"
          stroke="var(--sv-dev-2)"
          stroke-width="7"
          stroke-linecap="round"
        />
        <g transform="translate(610 372) rotate(-10)">
          {/* body stroke matches cable rim (~2) */}
          <rect
            x="0"
            y="-8"
            width="23"
            height="16"
            rx="3"
            fill="var(--sv-dev-1)"
            stroke={SK}
            stroke-width="2"
