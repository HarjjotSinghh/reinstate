---
import WaitlistForm from '../WaitlistForm.astro';
---

<section class="relative overflow-hidden border-b border-border">
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    aria-hidden="true"
    style="background:
      radial-gradient(ellipse 60% 50% at 80% 0%, color-mix(in oklch, var(--primary) 18%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 40% at 10% 80%, color-mix(in oklch, var(--accent) 8%, transparent), transparent 65%);"
  ></div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-14 sm:px-6 md:grid-cols-2 md:items-center md:gap-16 md:pb-24 md:pt-20">
    <div>
      <h1 class="text-balance text-[clamp(2.25rem,4vw+1rem,3.5rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-ink">
        Restore your AI coding workspace on any device
      </h1>
      <p class="mt-5 measure text-pretty text-base leading-relaxed text-muted md:text-lg">
        Encrypted same-vendor Claude Code and Codex sessions across configured
        devices. Broader continuity is planned after Phase 1.
      </p>
      <div class="mt-8 max-w-md">
        <WaitlistForm id="hero-waitlist" compact />
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a
          href="/docs/getting-started"
          class="font-medium text-ink underline-offset-4 hover:underline"
          >Read the docs</a
        >
        <a
          href="https://github.com/HarjjotSinghh/reinstate"
          class="text-muted underline-offset-4 hover:text-ink hover:underline"
          rel="noopener noreferrer"
          target="_blank">Star on GitHub</a
        >
      </div>
    </div>

    <div class="min-w-0">
      <div
        class="overflow-hidden rounded-xl border border-border bg-surface shadow-[0_8px_24px_color-mix(in_oklch,var(--ink)_8%,transparent)]"
      >
        <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
          <span class="ml-2 font-mono text-xs text-muted">terminal</span>
        </div>
        <pre
          class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-ink sm:text-sm"><code><span class="text-muted"># Device A — desktop</span>
<span class="text-[var(--accent)]">$</span> rein init
<span class="text-[var(--accent)]">$</span> rein push
<span class="text-muted"># encrypted · age · your bucket only</span>

<span class="text-muted"># Device B — laptop</span>
<span class="text-[var(--accent)]">$</span> rein pull
<span class="text-[var(--accent)]">$</span> claude --resume
<span class="text-primary"># context lives. paths remapped.</span></code></pre>
      </div>
      <p class="mt-3 text-xs text-muted">
        Short alias <code class="font-mono text-ink">rein</code> · full name
        <code class="font-mono text-ink">reinstate</code> · same binary
      </p>
    </div>
  </div>
</section>
