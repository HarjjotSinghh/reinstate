---
const agents = [
  { name: 'Claude Code', sessions: true, config: true, status: 'Priority (v0.1)' },
  { name: 'OpenAI Codex CLI', sessions: true, config: true, status: 'Priority (v0.1)' },
  { name: 'Gemini CLI', sessions: false, config: false, status: 'Phase 1' },
  { name: 'OpenCode', sessions: false, config: false, status: 'Phase 1' },
  { name: 'Grok Build', sessions: false, config: false, status: 'Phase 2' },
];
---

<section id="agents" class="border-b border-border">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
    <h2 class="display text-balance text-3xl tracking-tight text-ink md:text-4xl">
      Supported agents
    </h2>
    <p class="mt-4 max-w-xl measure text-pretty text-muted">
      Same-vendor resume only. Cross-agent value is portable config, skills, and environment —
      not replaying one model’s transcript into another.
    </p>

    <div class="mt-10 overflow-x-auto rounded-xl border border-border">
      <table class="w-full min-w-[32rem] text-left text-sm">
        <thead class="border-b border-border bg-surface text-muted">
          <tr>
            <th class="px-4 py-3 font-medium">Agent</th>
            <th class="px-4 py-3 font-medium">Sessions</th>
            <th class="px-4 py-3 font-medium">Config / MCP</th>
            <th class="px-4 py-3 font-medium">Status</th>
          </tr>
        </thead>
        <tbody>
          {
            agents.map((a) => (
              <tr class="border-b border-border last:border-0">
                <td class="px-4 py-3.5 font-medium text-ink">{a.name}</td>
                <td class="px-4 py-3.5 text-muted">{a.sessions ? 'Yes' : 'Planned'}</td>
                <td class="px-4 py-3.5 text-muted">{a.config ? 'Yes' : 'Planned'}</td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-xs text-ink">
                    {a.status}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-muted">
      Details in <a href="/docs/adapters" class="text-ink underline-offset-3 hover:underline">adapters docs</a>.
    </p>
  </div>
</section>
