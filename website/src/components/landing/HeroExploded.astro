                  text-anchor="middle"
                >
                  {s.key}
                </text>
              </g>
            ))
          }

          {/* keyboard and mouse on the near edge, centred like everything else */}
          <g class="unit dev board">
            <polygon class="f-side" points={kbd.side} />
            <polygon class="f-front" points={kbd.front} />
            <polygon class="f-top" points={kbd.top} />
          </g>
          <g class="keys" fill="var(--sv-dev-3)" opacity="0.75">
            {kbdRows.map((r) => <polygon points={r} />)}
          </g>
          <g class="unit dev board">
            <polygon class="f-side" points={mouse.side} />
            <polygon class="f-front" points={mouse.front} />
            <polygon class="f-top" points={mouse.top} />
          </g>

          {/* the chair, pulled out — seat under the desktop, low back tucked in */}
          <polygon class="cast hard" points={chairShadow} />
          <g class="unit furn">
            <polygon class="f-side" points={chair.base.side} />
            <polygon class="f-front" points={chair.base.front} />
            <polygon class="f-top" points={chair.base.top} />
          </g>
          <g class="unit dev">
            <polygon class="f-side" points={chair.post.side} />
            <polygon class="f-front" points={chair.post.front} />
            <polygon class="f-top" points={chair.post.top} />
          </g>
          <g class="unit dev board">
            <polygon class="f-side" points={chair.seat.side} />
            <polygon class="f-front" points={chair.seat.front} />
            <polygon class="f-top" points={chair.seat.top} />
          </g>
