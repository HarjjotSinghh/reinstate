---
import { box, P } from '../../lib/iso';
import WaitlistForm from '../WaitlistForm.astro';

/* ---- act 1 · the desk ---- */
const desk = {
  top: box(0, 0, -16, 330, 195, 16),
  legs: [
    box(18, 18, -132, 18, 18, 116),
    box(294, 18, -132, 18, 18, 116),
    box(18, 159, -132, 18, 18, 116),
    box(294, 159, -132, 18, 18, 116),
  ],
};
const monitor = box(0, 14, 10, 18, 118, 124);
const monitorFoot = box(-4, 46, 0, 30, 54, 10);
const tower = box(78, 36, 0, 176, 126, 42);
const underdesk = box(240, 96, -132, 56, 56, 40);
/* lifting apart, but still ONE stack: small even gaps, one shared axis.
   sessions (brand green) on top, settings (paper) at the bottom */
const streams = [
  { key: 'sessions', tone: 'a' },
  { key: 'mcp', tone: 'b' },
  { key: 'skills', tone: 'c' },
  { key: 'settings', tone: 'd' },
].map((s, i) => ({ ...s, g: box(84, 44, 54 + (3 - i) * 26, 160, 108, 15) }));
const mug = box(252, 152, 0, 30, 30, 34);
const board = box(96, 176, 0, 150, 40, 9);

/* ---- act 2 · the checkpoint on its nightstand ---- */
const plinth = box(-6, -6, -106, 160, 160, 10);
const cabinet = box(0, 0, -96, 148, 148, 96);
/* seated on the cabinet top (z=0), not floating */
const seal = box(14, 14, 0, 120, 120, 120);

/* ---- act 3 · the couch table ---- */
const table = {
  top: box(0, 0, -16, 248, 186, 16),
  legs: [
    box(16, 16, -130, 16, 16, 114),
    box(216, 16, -130, 16, 16, 114),
    box(16, 154, -130, 16, 16, 114),
    box(216, 154, -130, 16, 16, 114),
  ],
};
/* deeper deck → visible palm-rest strip in front of the restored layers */
const deck = box(24, 30, 0, 196, 140, 18);
const lidBack = box(38, 8, 18, 178, 13, 88);
/* put back: flush stack resting on the deck (top z=18), sessions on top */
const restacked = [
  { key: 'settings', tone: 'd' },
  { key: 'skills', tone: 'c' },
  { key: 'mcp', tone: 'b' },
  { key: 'sessions', tone: 'a' },
].map((s, i) => ({ ...s, g: box(40, 38, 18 + i * 15, 160, 108, 15) }));

/* ---- props ---- */
const pot = box(0, 0, -74, 76, 76, 74);

const legend = [
  { key: 'sessions', tone: 'a', note: 'threads and dead ends' },
  { key: 'mcp', tone: 'b', note: 'servers, args, env' },
  { key: 'skills', tone: 'c', note: 'the ones you wrote' },
  { key: 'settings', tone: 'd', note: 'per agent, per project' },
];

const SK = 'var(--sv-stroke)';
const INK = 'var(--sv-ink)';
const DIM = 'var(--sv-dim)';
const PRIM = 'var(--sv-prim)';
const PRIM_DEEP = 'var(--sv-prim-deep)';

/* ---- projected-text helpers (same 30° projector as lib/iso) ---- */
const CX = Math.cos(Math.PI / 6);
const m2 = (m: number[]) => `matrix(${m.map((n) => +n.toFixed(2)).join(' ')})`;
/* text on a +x side face: origin = far top corner, u recedes right-up, v down */
const sideText = (x: number, y: number, z: number, w: number, d: number, h: number) => {
  const [e, f] = P(x + w, y + d, z + h);
  return m2([CX, -0.5, 0, 1, e, f]);
};
/* text on a +y front face: origin = near-left top corner, u recedes right-down, v down */
const frontText = (x: number, y: number, z: number, d: number, h: number) => {
  const [e, f] = P(x, y + d, z + h);
  return m2([CX, 0.5, 0, 1, e, f]);
};

/* group transforms, for scene-absolute anchors */
const S = 1.02;
const at = (gx: number, gy: number, p: [number, number]) => [gx + p[0] * S, gy + p[1] * S] as const;

/* arrow anchors, computed from the geometry so they land exactly on the art */
const pushStart = at(392, 452, P(244, 98, 139.5)); // top layer, right face center
const pushEnd = at(866, 452, P(30, 74, 120)); // into the checkpoint's top face
const pullStart = at(866, 452, P(126, 44, 120)); // out of the top face
const pullEnd = at(1176, 452, P(52, 60, 78)); // onto the restored stack's top face

/* contact shadows: under each object's projected footprint center */
const shadows = [
  { cx: 452, cy: 720, rx: 215, ry: 12 }, // desk
  { cx: 866, cy: 636, rx: 112, ry: 10 }, // nightstand
  { cx: 1203, cy: 695, rx: 178, ry: 11 }, // table
  { cx: 140, cy: 710, rx: 64, ry: 9 }, // plant
];
---

<div class="hero-block">
    <div class="lede">
      <span class="badge"><i aria-hidden="true"></i> Pull apart, seal, put back</span>
      <h1>Restore your AI coding workspace on any device</h1>
      <p class="sub">
        Sessions, MCP servers, skills, and settings, across every coding agent and
        every machine you own. Encrypted so only you can read it.
      </p>
      <div class="join-wrap" id="join">
        <WaitlistForm id="hero-waitlist" compact />
      </div>
      <p class="micro">Apache&#8209;2.0 · one Go binary · your bucket, your keys</p>
    </div>

    <figure class="scene">
      <svg viewBox="0 0 1640 856" role="img" aria-labelledby="etitle edesc" preserveAspectRatio="xMidYMax meet">
        <title id="etitle">One room, two machines, 23:41 to 23:47</title>
        <desc id="edesc">
          A desk at night. Four layers of agent state, sessions, MCP servers, skills and
          settings, lift out of the desktop, seal into one encrypted Reinstate checkpoint,
          and drop back into a laptop on the table across the room with every path remapped.
        </desc>

        <defs>
          <marker id="arw" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
            <path d="M0 0 L12 6 L0 12 z" fill={PRIM_DEEP} />
          </marker>
          <clipPath id="pane"><rect x="126" y="52" width="272" height="196" rx="4" /></clipPath>
        </defs>

        {/* ---------- room ---------- */}
        <rect x="0" y="0" width="1640" height="322" fill="var(--sv-wall)" />
        <rect x="0" y="322" width="1640" height="534" fill="var(--sv-floor)" />
        <line x1="0" y1="322" x2="1640" y2="322" stroke={SK} stroke-width="2.5" />
        <rect x="0" y="322" width="1640" height="16" fill="var(--sv-skirt)" />

        <g class="floorlines" stroke="var(--sv-floorline)" stroke-width="1.5" fill="none">
          <path d="M-200 856 L560 338 M120 856 L760 338 M460 856 L960 338 M820 856 L1160 338 M1180 856 L1360 338 M1540 856 L1560 338" />
          <path d="M0 430 H1640 M0 530 H1640 M0 640 H1640 M0 750 H1640" />
        </g>

        {/* window */}
        <g class="window">
          <rect x="118" y="44" width="288" height="212" rx="6" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
          <rect x="126" y="52" width="272" height="196" rx="4" fill="var(--sv-night)" />
          <g clip-path="url(#pane)" class="stars" fill="var(--sv-star)">
            <circle class="moonhalo" cx="340" cy="88" r="17" opacity="0.16" />
            <circle cx="340" cy="88" r="9" opacity="0.9" />
            <circle class="st" style="--d:-0.4s; --t:3.2s" cx="172" cy="94" r="2.6" />
            <circle class="st" style="--d:-1.7s; --t:4.1s" cx="248" cy="72" r="2" />
            <circle class="st" style="--d:-2.6s; --t:3.6s" cx="316" cy="112" r="2.4" />
            <circle class="st" style="--d:-1.1s; --t:4.6s" cx="204" cy="150" r="1.8" />
            <circle class="st" style="--d:-3.3s; --t:3.9s" cx="360" cy="170" r="2" />
            <circle class="st" style="--d:-2.2s; --t:4.3s" cx="286" cy="176" r="2.2" />
            <g fill="var(--sv-city)">
              <rect x="134" y="196" width="34" height="52" />
              <rect x="176" y="168" width="26" height="80" />
              <rect x="210" y="204" width="40" height="44" />
              <rect x="258" y="180" width="30" height="68" />
              <rect x="296" y="212" width="44" height="36" />
              <rect x="348" y="186" width="28" height="62" />
            </g>
            {/* lit windows, blinking on and off in offset groups */}
            <g class="citylights">
              <g class="l1">
                <rect x="140" y="204" width="5" height="7" />
                <rect x="182" y="180" width="5" height="7" />
                <rect x="264" y="192" width="5" height="7" />
                <rect x="304" y="222" width="5" height="7" />
                <rect x="354" y="196" width="5" height="7" />
              </g>
              <g class="l2">
                <rect x="152" y="216" width="5" height="7" />
                <rect x="192" y="196" width="5" height="7" />
                <rect x="218" y="214" width="5" height="7" />
                <rect x="274" y="208" width="5" height="7" />
                <rect x="318" y="230" width="5" height="7" />
              </g>
              <g class="l3">
                <rect x="140" y="228" width="5" height="7" />
                <rect x="182" y="212" width="5" height="7" />
                <rect x="232" y="224" width="5" height="7" />
                <rect x="264" y="224" width="5" height="7" />
                <rect x="330" y="220" width="5" height="7" />
                <rect x="364" y="212" width="5" height="7" />
              </g>
            </g>
          </g>
          <line x1="262" y1="52" x2="262" y2="248" stroke={SK} stroke-width="3" />
          <line x1="126" y1="150" x2="398" y2="150" stroke={SK} stroke-width="3" />
          <rect x="104" y="256" width="316" height="14" rx="3" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
        </g>

        {/* pendant lamp: a ceiling anchor, spotlighting the checkpoint */}
        <g class="lamp">
          <line x1="866" y1="0" x2="866" y2="98" stroke={SK} stroke-width="2.5" />
          <polygon points="840,138 892,138 878,100 854,100" fill="var(--sv-dev-2)" stroke={SK} stroke-width="3" stroke-linejoin="round" />
          <circle cx="866" cy="142" r="5" fill="var(--sv-star)" />
        </g>

        {/* poster: the brand frame, actually legible now */}
        <g class="poster">
          <rect x="1088" y="56" width="196" height="150" rx="5" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
          <rect x="1102" y="70" width="168" height="122" fill="var(--sv-night)" />
          <g transform="translate(1186 122) scale(0.58)">
            <polygon points="0,-46 66,-8 0,30 -66,-8" fill={PRIM} stroke={SK} stroke-width="6" stroke-linejoin="round" />
            <polygon points="0,10 66,-28 66,20 0,58" fill="var(--sv-seal-2)" stroke={SK} stroke-width="6" stroke-linejoin="round" />
            <polygon points="0,10 -66,-28 -66,20 0,58" fill="var(--sv-seal-3)" stroke={SK} stroke-width="6" stroke-linejoin="round" />
          </g>
          <text class="pbrand" x="1186" y="176" text-anchor="middle" fill="#e9efe3">reinstate</text>
        </g>

        {/* lamplight pool */}
        <ellipse class="glow" cx="866" cy="430" rx="190" ry="130" fill={PRIM} opacity="0.05" />

        {/* ---------- contact shadows ---------- */}
        <g class="shadows" fill={INK}>
          {shadows.map((s) => (
            <ellipse cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry} />
          ))}
        </g>

        {/* plant: leaves grow OUT of the soil, not from behind the pot */}
        <g class="plant" transform="translate(140 596) scale(1.02)">
          <g class="unit pot">
            <polygon class="f-side" points={pot.side} />
            <polygon class="f-front" points={pot.front} />
            <polygon class="f-top" points={pot.top} />
          </g>
          <polygon points="0,16 38.1,38 0,60 -38.1,38" fill="var(--sv-seal-3)" />
          <g transform="translate(0 10)">
            <g class="sway" stroke={SK} stroke-width="3" stroke-linejoin="round">
              <path d="M0 26 C -34 -38, -22 -96, 6 -126 C 22 -80, 20 -20, 0 26 z" fill="var(--sv-leaf-1)" />
              <path d="M0 26 C -66 -8, -96 -52, -100 -90 C -58 -72, -20 -26, 0 26 z" fill="var(--sv-leaf-2)" />
              <path d="M0 26 C 54 -2, 86 -42, 92 -82 C 50 -66, 18 -22, 0 26 z" fill="var(--sv-leaf-2)" />
              <path d="M0 26 C 34 -38, 62 -74, 92 -88 C 74 -42, 38 2, 0 26 z" fill="var(--sv-leaf-1)" />
            </g>
          </g>
        </g>

        {/* ---------- ACT 1 · the desk ---------- */}
        <g transform="translate(392 452) scale(1.02)">
          <g class="unit furn">
            <polygon class="f-side" points={underdesk.side} />
            <polygon class="f-front" points={underdesk.front} />
            <polygon class="f-top" points={underdesk.top} />
          </g>
          <g class="unit furn">
            {desk.legs.map((l) => (
              <g>
                <polygon class="f-side" points={l.side} />
                <polygon class="f-front" points={l.front} />
              </g>
            ))}
            <polygon class="f-side" points={desk.top.side} />
            <polygon class="f-front" points={desk.top.front} />
            <polygon class="f-top" points={desk.top.top} />
          </g>

          <g class="unit dev">
            <polygon class="f-side" points={mug.side} />
            <polygon class="f-front" points={mug.front} />
            <polygon class="f-top" points={mug.top} />
          </g>
          <g class="unit dev">
            <polygon class="f-side" points={board.side} />
            <polygon class="f-front" points={board.front} />
            <polygon class="f-top" points={board.top} />
          </g>

          <g class="unit dev">
            <polygon class="f-side" points={monitorFoot.side} />
            <polygon class="f-front" points={monitorFoot.front} />
            <polygon class="f-top" points={monitorFoot.top} />
          </g>
          <g class="unit dev screen">
            <polygon class="f-side" points={monitor.side} />
            <polygon class="f-front" points={monitor.front} />
            <polygon class="f-top" points={monitor.top} />
          </g>

          {/* the session, projected onto the monitor glass */}
          <g transform={sideText(0, 14, 10, 18, 118, 124)}>
            <rect x="8" y="10" width="72" height="20" rx="10" fill={PRIM} />
            <text x="44" y="24" text-anchor="middle" font-size="11" font-weight="600" fill="#131f1a">ses_7f3a</text>
            <g fill="var(--sv-star)" opacity="0.45">
              <rect x="8" y="40" width="88" height="5" rx="2.5" />
              <rect x="8" y="52" width="62" height="5" rx="2.5" />
              <rect x="8" y="64" width="76" height="5" rx="2.5" />
            </g>
            <rect class="cursor" x="92" y="61" width="6" height="11" fill="var(--sv-star)" />
            <text x="8" y="88" font-size="12" fill="var(--sv-star)">⏸ 23:41</text>
          </g>

          <g class="unit dev">
            <polygon class="f-side" points={tower.side} />
            <polygon class="f-front" points={tower.front} />
            <polygon class="f-top" points={tower.top} />
          </g>

          {
            streams.map((s, i) => (
              <g class={`unit tray t-${s.tone}`} style={`--i:${i}`}>
                <polygon class="f-side" points={s.g.side} />
                <polygon class="f-front" points={s.g.front} />
                <polygon class="f-top" points={s.g.top} />
                <text
                  class="tlabel"
                  transform={frontText(84, 44, 54 + (3 - i) * 26, 108, 15)}
                  x="80"
                  y="11.5"
                  text-anchor="middle"
                >
                  {s.key}
                </text>
              </g>
            ))
          }
        </g>

        {/* ---------- ACT 2 · sealed, on the nightstand ---------- */}
        <g transform="translate(866 452) scale(1.02)">
          <g class="unit furn">
            <polygon class="f-side" points={plinth.side} />
            <polygon class="f-front" points={plinth.front} />
            <polygon class="f-top" points={plinth.top} />
          </g>
          <g class="unit furn">
            <polygon class="f-side" points={cabinet.side} />
            <polygon class="f-front" points={cabinet.front} />
            <polygon class="f-top" points={cabinet.top} />
          </g>
          {/* drawer seam + knobs, on the cabinet's front face */}
          <line x1="-121.2" y1="126" x2="-6.9" y2="192" stroke={SK} stroke-width="2.5" />
          <circle cx="-64.1" cy="135" r="4" fill="var(--sv-furn-1)" stroke={SK} stroke-width="2" />
          <circle cx="-64.1" cy="183" r="4" fill="var(--sv-furn-1)" stroke={SK} stroke-width="2" />

          <g class="sealwrap">
            <g class="unit sealbox">
              <polygon class="f-side" points={seal.side} />
              <polygon class="f-front" points={seal.front} />
              <polygon class="f-top" points={seal.top} />
            </g>
            {/* applied to the cube, not floating: brand diamond on top, lock + session on the face */}
            <polygon
              points="0,-66 34.6,-46 0,-26 -34.6,-46"
              fill="none"
              stroke={PRIM}
              stroke-width="4.5"
              stroke-linejoin="round"
            />
            <g transform={frontText(14, 14, 0, 120, 120)}>
              <path d="M51 44 v-7 a 9 9 0 0 1 18 0 v 7" fill="none" stroke={PRIM} stroke-width="4" stroke-linecap="round" />
              <rect x="47" y="44" width="26" height="20" rx="5" fill={PRIM} />
              <rect x="22" y="78" width="76" height="22" rx="11" fill={PRIM} />
              <text x="60" y="93" text-anchor="middle" font-size="11.5" font-weight="600" fill="#131f1a">ses_7f3a</text>
            </g>
          </g>
        </g>

        {/* ---------- ACT 3 · the table ---------- */}
        <g transform="translate(1176 452) scale(1.02)">
          <g class="unit furn">
            {table.legs.map((l) => (
              <g>
                <polygon class="f-side" points={l.side} />
                <polygon class="f-front" points={l.front} />
              </g>
            ))}
            <polygon class="f-side" points={table.top.side} />
            <polygon class="f-front" points={table.top.front} />
            <polygon class="f-top" points={table.top.top} />
          </g>
          <g class="unit dev lid">
            <polygon class="f-side" points={lidBack.side} />
            <polygon class="f-front" points={lidBack.front} />
            <polygon class="f-top" points={lidBack.top} />
          </g>

          {/* the same session, resumed — projected onto the laptop screen */}
          <g transform={frontText(38, 8, 18, 13, 88)}>
            <rect x="12" y="6" width="72" height="20" rx="10" fill={PRIM} />
            <text x="48" y="20" text-anchor="middle" font-size="11" font-weight="600" fill="#131f1a">ses_7f3a</text>
            <text x="96" y="20" font-size="11" fill="#e9efe3">▶ 23:47</text>
          </g>

          <g class="unit dev">
            <polygon class="f-side" points={deck.side} />
            <polygon class="f-front" points={deck.front} />
            <polygon class="f-top" points={deck.top} />
          </g>
          {/* touchpad on the palm-rest strip */}
