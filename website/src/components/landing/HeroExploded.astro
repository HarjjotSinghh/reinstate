            points="-48.5,104 -3.5,130 -15.6,137 -60.6,111"
            fill="var(--sv-dev-2)"
            stroke={SK}
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          {
            restacked.map((s, i) => (
              <g class={`unit tray back t-${s.tone}`} style={`--i:${i}`}>
                <polygon class="f-side" points={s.g.side} />
                <polygon class="f-front" points={s.g.front} />
                <polygon class="f-top" points={s.g.top} />
                <text
                  class="tlabel"
                  transform={frontText(40, 38, 18 + i * 15, 108, 15)}
                  x="80"
                  y="11.5"
                  text-anchor="middle"
                >
                  {s.key}
                </text>
              </g>
            ))
          }
        </g>

        {/* ---------- connectors: anchored to the geometry, one rhythm ---------- */}
        <path
          class="wire"
          d={`M ${pushStart[0].toFixed(0)} ${pushStart[1].toFixed(0)} C 600 380, 700 340, ${pushEnd[0].toFixed(0)} ${pushEnd[1].toFixed(0)}`}
          fill="none"
          stroke={PRIM_DEEP}
          stroke-width="3.6"
          stroke-linecap="round"
          marker-end="url(#arw)"
        />
        <path
          class="wire"
          d={`M ${pullStart[0].toFixed(0)} ${pullStart[1].toFixed(0)} C 1005 340, 1135 360, ${pullEnd[0].toFixed(0)} ${pullEnd[1].toFixed(0)}`}
          fill="none"
          stroke={PRIM_DEEP}
          stroke-width="3.6"
          stroke-linecap="round"
          marker-end="url(#arw)"
        />

        {/* command labels: terminal chips riding the arcs, one baseline */}
        <g class="cmdchip">
          <rect x="585" y="336" width="150" height="34" rx="17" fill="var(--paper-2)" stroke="var(--rule)" stroke-width="1.5" />
          <text x="660" y="359" text-anchor="middle"><tspan class="ta">$</tspan> rein push</text>
        </g>
        <g class="cmdchip">
          <rect x="1000" y="336" width="146" height="34" rx="17" fill="var(--paper-2)" stroke="var(--rule)" stroke-width="1.5" />
          <text x="1073" y="359" text-anchor="middle"><tspan class="ta">$</tspan> rein pull</text>
        </g>
      </svg>
    </figure>

    <section class="under" id="how">
      <ul class="legend" aria-label="What moves">
        {
          legend.map((l) => (
            <li>
              <i class={`sw t-${l.tone}`} aria-hidden="true" />
              <b>{l.key}</b>
              <span>{l.note}</span>
            </li>
          ))
        }
      </ul>

      <ol class="steps">
        <li>
          <b>pull apart on the desktop</b>
          <span>23:41 · nothing has left the machine yet</span>
        </li>
        <li>
          <b>seal into one object</b>
          <span>age · x25519 · your key never moves</span>
        </li>
        <li>
          <b>put back on the laptop</b>
          <span>23:47 · paths remapped · the thread continues</span>
        </li>
      </ol>

      <div class="strip">
        <span>Reinstates</span>
        <ul>
          <li>Claude Code</li>
          <li>Codex</li>
          <li>Gemini CLI</li>
          <li>OpenCode</li>
          <li>Grok Build</li>
        </ul>
      </div>
    </section>
</div>

<style>
  .hero-block {
    /* ---- light (default) ---- */
    --paper: #e4e7dd;
