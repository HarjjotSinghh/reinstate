            <rect x="9" y="82" width="42" height="18" rx="4" fill="var(--sv-dev-1)" opacity="0.6" />
          </g>

          <g class="unit furn">
            {frame.legs.map((l) => (
              <g>
                <polygon class="f-side" points={l.side} />
                <polygon class="f-front" points={l.front} />
