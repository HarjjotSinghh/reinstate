<script>
  import { copyInstallCommand } from '../../lib/install-copy';

  const copyButton = document.getElementById('copy-install');
  const commandText = document.getElementById('install-command-text');
  const copyStatus = document.getElementById('copy-status');
  let resetCopyState: number | undefined;

  copyButton?.addEventListener('click', async () => {
    if (!commandText || !copyStatus) return;

    const command = copyButton.dataset.command ?? commandText.textContent ?? '';
    window.clearTimeout(resetCopyState);

    try {
      const analyticsWindow = window as Window & {
        reinstateTrack?: (
          eventName: 'install_command_copy',
          target: 'homepage-hero',
        ) => boolean;
      };
      await copyInstallCommand(
        command,
        navigator.clipboard.writeText.bind(navigator.clipboard),
        analyticsWindow.reinstateTrack,
      );
      copyButton.dataset.state = 'copied';
      copyButton.setAttribute('aria-label', 'Install command copied');
      copyStatus.textContent = 'Install command copied';
    } catch {
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(commandText);
      selection?.removeAllRanges();
      selection?.addRange(range);
      copyStatus.textContent = 'Command selected. Press Control C or Command C to copy.';
    }

    resetCopyState = window.setTimeout(() => {
      copyButton.dataset.state = 'idle';
      copyButton.setAttribute('aria-label', 'Copy install command');
      copyStatus.textContent = '';
    }, 1800);
  });
</script>

