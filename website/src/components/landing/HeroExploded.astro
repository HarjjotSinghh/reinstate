---
import { product } from '../../data/product';
import { box, fmt, P } from '../../lib/iso';

const verifiedDate = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${product.lastVerified}T00:00:00Z`));

/* floor plane of the desk group; every act sits its feet on its own z-floor */
const FLOOR = -132;

/* a flat quad on a horizontal plane: contact shadows, insets, top-face detail */
const foot = (x: number, y: number, z: number, w: number, d: number) =>
  fmt([P(x, y, z), P(x + w, y, z), P(x + w, y + d, z), P(x, y + d, z)]);

/* ---- one table, built once, used by both acts ----
   Same footprint left and right, mirrored about the scene's centre line, so the
   composition is symmetric and only the CONTENTS tell the two ends apart. */
const TW = 300;
const TD = 186;
const TCX = TW / 2; // 150 — every desktop object centres on this
const frame = {
  top: box(0, 0, -16, TW, TD, 16),
  legs: [
    box(16, 16, FLOOR, 16, 16, 116),
    box(268, 16, FLOOR, 16, 16, 116),
    box(16, 154, FLOOR, 16, 16, 116),
    box(268, 154, FLOOR, 16, 16, 116),
  ],
};
const frameShadow = foot(2, 2, FLOOR, TW, TD);
const frameFeet = [
  [16, 16],
  [268, 16],
  [16, 154],
  [268, 154],
].map(([x, y]) => foot(x, y, FLOOR, 16, 16));

/* the chair stands off the near (+y) edge and faces the table: the backrest is
   on the seat's NEAR edge, so it turns its back to us and its seat to the desk.
   Back is narrower than the seat, so the seat slab still reads around it. */
/* scaled up against the table: the backrest now clears the desktop, which is
   what sells the chair as furniture rather than a stool */
const chair = {
  base: box(122, 218, FLOOR, 56, 56, 7),
  post: box(140, 236, FLOOR + 7, 18, 18, 52),
  /* seat is compact; the backrest is the tall element, as on a real task chair */
  seat: box(110, 204, -73, 76, 70, 11),
  /* stub + floating backrest: the gap between seat and back is what makes an
     office chair read as a chair instead of a slab on a pedestal */
  stub: box(136, 268, -62, 26, 7, 17),
  back: box(112, 266, -45, 72, 11, 80),
};
const chairShadow = foot(122, 218, FLOOR, 56, 56);

/* ---- act 1 · the desktop ---- */
/* foot plate → neck → panel, turned sideways: the glass is the +x face, so the
   screen reads clear of the lifted stack. Panel ~16:9, centred on the desk
   depth (186). Margin to every table edge — nothing flush, nothing overhangs. */
const monitorFoot = box(26, 64, 0, 50, 54, 8);
const monitorStem = box(40, 80, 8, 18, 20, 42);
const monitorPanel = box(40, 10, 50, 18, 164, 96);
/* the dock the state lifts out of, and the tower standing on the floor below */
const dock = box(84, 24, 0, 148, 98, 16);
const towerPC = box(218, 86, FLOOR, 60, 60, 112);
const kbd = box(94, 132, 0, 140, 34, 8);
const kbdRows = [
  foot(102, 137, 8, 124, 6),
  foot(102, 146, 8, 124, 6),
  foot(102, 155, 8, 100, 6),
];
const mouse = box(244, 134, 0, 26, 32, 10);
/* tray slabs: tall enough for legible labels, spaced so lines don't collide.
   Desktop stack is full-size; laptop stack is a touch smaller and sits forward
   on the palm rest so it never covers the lid chrome. */
const SLAB_W = 128;
const SLAB_D = 82;
const SLAB_H = 16;
const LIFT_PITCH = 28; /* air between lifted layers */
const FLUSH_PITCH = SLAB_H;
/* Listed bottom-up (paths → session) so render order = painter order. */
const streams = [
  { key: 'paths', tone: 'd' },
  { key: 'metadata', tone: 'c' },
  { key: 'messages', tone: 'b' },
  { key: 'session', tone: 'a' },
].map((s, i) => ({ ...s, g: box(94, 32, 28 + i * LIFT_PITCH, SLAB_W, SLAB_D, SLAB_H) }));

/* ---- act 2 · the checkpoint on its nightstand ---- */
const plinth = box(-6, -6, -106, 160, 160, 10);
const cabinet = box(0, 0, -96, 148, 148, 96);
/* seated on the cabinet top (z=0), not floating */
const seal = box(14, 14, 0, 120, 120, 120);
/* a rug that anchors the centre act; square, so it centres on the cabinet */
const rug = foot(-36, -36, -106, 220, 220);
const rugInner = foot(-20, -20, -106, 188, 188);

/* ---- act 3 · the laptop ---- */
/* deck → hinge → taller lid. Lid clears the flush stack so ses_7f3a / time
   stay fully readable above the trays. */
const deck = box(58, 36, 0, 164, 132, 15);
const hinge = box(58, 24, 15, 164, 12, 9);
const lidBack = box(60, 26, 24, 160, 10, 118);
/* a recessed keyboard well with light keys inside it — thin dark strips on a
   dark deck read as scratches, not as a keyboard */
const deckWell = foot(72, 138, 15, 132, 22);
const deckKeys = [
  foot(76, 140, 15, 124, 5),
  foot(76, 147, 15, 124, 5),
  foot(76, 154, 15, 100, 5),
];
const touchpad = foot(110, 164, 15, 56, 8);
/* the mirror of the tower: same floor slot, closed storage instead of a machine */
const crate = box(218, 86, FLOOR, 60, 60, 66);
/* flush stack on the palm rest (forward of the lid), slightly smaller footprint */
const LAP_SLAB_W = 118;
const LAP_SLAB_D = 74;
const restacked = [
  { key: 'paths', tone: 'd' },
  { key: 'metadata', tone: 'c' },
  { key: 'messages', tone: 'b' },
  { key: 'session', tone: 'a' },
].map((s, i) => ({ ...s, g: box(80, 58, 15 + i * FLUSH_PITCH, LAP_SLAB_W, LAP_SLAB_D, SLAB_H) }));

/* ---- props ---- */
const pot = box(0, 0, -74, 76, 76, 74);

/* floor lamp, far right — it stands on the floor, nothing hangs from nothing.
   Local screen space runs y 2 (shade top) → 273 (base on the floor). */
const lampBase = box(0, 0, -244, 58, 58, 11);
const lampPole = box(23, 23, -233, 12, 12, 186);

const SK = 'var(--sv-stroke)';
const INK = 'var(--sv-ink)';
const DIM = 'var(--sv-dim)';
const PRIM = 'var(--sv-prim)';
const PRIM_DEEP = 'var(--sv-prim-deep)';

/* ---- projected-text helpers (same 30° projector as lib/iso) ---- */
const CX = Math.cos(Math.PI / 6);
const m2 = (m: number[]) => `matrix(${m.map((n) => +n.toFixed(2)).join(' ')})`;
/* text on a +x side face: origin = far top corner, u recedes right-up, v down */
const sideText = (x: number, y: number, z: number, w: number, d: number, h: number) => {
  const [e, f] = P(x + w, y + d, z + h);
  return m2([CX, -0.5, 0, 1, e, f]);
};
/* text on a +y front face: origin = near-left top corner, u recedes right-down, v down */
const frontText = (x: number, y: number, z: number, d: number, h: number) => {
  const [e, f] = P(x, y + d, z + h);
  return m2([CX, 0.5, 0, 1, e, f]);
};

/* group transforms, for scene-absolute anchors */
const S = 1.02;
const at = (gx: number, gy: number, p: [number, number]) => [gx + p[0] * S, gy + p[1] * S] as const;

/* three acts on one centre line: 820 is the middle of the 1640 canvas, and the
   two tables sit at an equal ±430 from it. A w×d footprint's visual centre is
   offset ((w-d)/2)·cos30·S from its group origin, hence the 50. */
const MID = 820;
const SPAN = 430;
const TOFF = ((TW - TD) / 2) * CX * S;
const GX_L = Math.round(MID - SPAN - TOFF);
const GX_C = MID;
const GX_R = Math.round(MID + SPAN - TOFF);
const GY = 452;

/* arrow anchors, computed from the geometry so they land exactly on the art */
const pushStart = at(GX_L, GY, P(94 + SLAB_W, 32 + SLAB_D / 2, 28 + 3 * LIFT_PITCH + SLAB_H / 2));
const pushEnd = at(GX_C, GY, P(30, 74, 120)); // into the checkpoint's top face
const pullStart = at(GX_C, GY, P(126, 44, 120)); // out of the top face
const pullEnd = at(GX_R, GY, P(80 + LAP_SLAB_W / 2, 58 + LAP_SLAB_D / 2, 15 + 4 * FLUSH_PITCH));

/* contact shadows: the object's own base rectangle, projected flat on the floor.
   Drawn inside each group, so they track the geometry instead of being guessed. */
const towerShadow = foot(218, 86, FLOOR, 60, 60);
const standShadow = foot(-6, -6, -106, 160, 160);
const potShadow = foot(0, 0, -74, 76, 76);
const lampShadow = foot(0, 0, -244, 58, 58);

/* floor grid drawn along the two projection axes, so it agrees with every solid */
const GS = 0.5 / Math.cos(Math.PI / 6);
const RUN = 1640 * GS;
const floorGrid = [
  ...Array.from({ length: 20 }, (_, i) => {
    const b = -960 + i * 98;
    return `M0 ${b} L1640 ${(b + RUN).toFixed(0)}`;
  }),
  ...Array.from({ length: 16 }, (_, i) => {
    const b = 300 + i * 98;
    return `M0 ${b} L1640 ${(b - RUN).toFixed(0)}`;
  }),
].join(' ');
---

<div class="hero-block">
    <div class="lede">
      <span class="badge"><i aria-hidden="true"></i> Capture. Encrypt. Reinstate.</span>
      <h1>Start on one device.<br />Continue on another. Same session.</h1>
      <p class="sub">
        Move encrypted Claude Code or Codex sessions between macOS and Windows.
        Reinstate encrypts the session locally, then stores it in your own S3 or R2 bucket.
      </p>

      <div class="hero-conversion">
        <div class="install-command" role="group" aria-label="Install command">
          <span class="prompt" aria-hidden="true">$</span>
          <code id="install-command-text">curl -fsSL https://reinstate.dev/install.sh | sh</code>
          <button
            id="copy-install"
            type="button"
            data-command="curl -fsSL https://reinstate.dev/install.sh | sh"
            data-state="idle"
            aria-label="Copy install command"
          >
            <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8.5" y="8.5" width="11" height="11" rx="1.5"></rect>
              <path d="M15.5 8.5V5.8c0-.72-.58-1.3-1.3-1.3H5.8c-.72 0-1.3.58-1.3 1.3v8.4c0 .72.58 1.3 1.3 1.3h2.7"></path>
            </svg>
            <svg class="copied-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5.5 12.5 4.1 4.1 8.9-9.2"></path>
            </svg>
            <span id="copy-status" class="sr" aria-live="polite"></span>
          </button>
        </div>

        <div class="conversion-meta">
          <nav class="hero-links" aria-label="Installation resources">
            <a
              href="/docs/getting-started"
              data-analytics-event="docs_getting_started"
              data-analytics-target="homepage-hero"
            >
              Read setup guide
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
              </svg>
            </a>
            <a
              href="https://github.com/HarjjotSinghh/reinstate"
              data-analytics-event="github_click"
              data-analytics-target="homepage-hero"
              rel="noopener noreferrer"
              target="_blank"
            >
              View on GitHub
              <!-- GitHub's official mark-github Octicon. -->
              <svg class="github-mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"></path>
              </svg>
            </a>
          </nav>

          <div class="availability" aria-label="Current compatibility">
            <span class="available">
              <i aria-hidden="true"></i>
              <strong>Available now:</strong> Claude Code · Codex
            </span>
            <span class="platform">macOS ↔ Windows</span>
          </div>
        </div>
      </div>

      <ol class="mechanism" aria-label="How Reinstate works">
        <li>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="4.5" y="3.5" width="10" height="13" rx="1.5"></rect>
              <path d="M9.5 8.5h8.2M17.7 8.5l-2.5-2.4M17.7 8.5l-2.5 2.4"></path>
              <path d="M8 19.5h10.5v-7"></path>
            </svg>
          </span>
          <span class="step-copy">
            <span class="step-heading"><span class="step-no">1</span><strong>Capture</strong></span>
            <small>Select a local session</small>
          </span>
        </li>
        <li>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="5" y="10" width="14" height="10" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
              <path d="M12 14v2"></path>
            </svg>
          </span>
          <span class="step-copy">
            <span class="step-heading"><span class="step-no">2</span><strong>Encrypt</strong></span>
            <small>Seal it before upload</small>
          </span>
        </li>
        <li>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="8.5" y="4" width="11" height="15" rx="1.5"></rect>
              <path d="M4 9.5h9M4 9.5l3-3M4 9.5l3 3"></path>
              <path d="M12.5 16h3"></path>
            </svg>
          </span>
          <span class="step-copy">
            <span class="step-heading"><span class="step-no">3</span><strong>Reinstate</strong></span>
            <small>Pull and resume natively</small>
          </span>
        </li>
      </ol>

      <p class="micro">
        <code>rein</code> is the CLI for Reinstate<span class="micro-separator" aria-hidden="true">·</span>Apache&#8209;2.0<span class="micro-separator" aria-hidden="true">·</span>one Go binary<span class="micro-separator" aria-hidden="true">·</span>your bucket, your keys<span class="micro-separator" aria-hidden="true">·</span>
        Verified <time datetime={product.lastVerified}>{verifiedDate}</time>
      </p>
    </div>

    <figure class="scene">
      {/* viewBox extends upward so wall art can sit ~170px higher without clipping */}
      <svg viewBox="0 -170 1640 1026" role="img" aria-labelledby="etitle edesc" preserveAspectRatio="xMidYMax meet">
        <title id="etitle">One room, two machines, 23:41 to 23:47</title>
        <desc id="edesc">
          A desk at night. Four layers of portable session state — paths, metadata,
          messages, and the session record — lift out of the desktop, seal into one
          encrypted Reinstate checkpoint, and drop back into a laptop on the table across
          the room with every path remapped.
        </desc>

        <defs>
          <marker id="arw" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="5.5" markerHeight="5.5" orient="auto-start-reverse">
            <path d="M0 0 L12 6 L0 12 z" fill={PRIM_DEEP} />
          </marker>
          {/* local coords match geometry inside transformed groups (clip follows CTM) */}
          <clipPath id="pane"><rect x="126" y="52" width="272" height="196" rx="4" /></clipPath>
          <clipPath id="floorclip"><rect x="0" y="338" width="1640" height="518" /></clipPath>
          {/* art inset matches the painting canvas; mountains stay fully inside */}
          <clipPath id="art"><rect x="1282" y="74" width="192" height="162" /></clipPath>
        </defs>

        {/* ---------- room (wall extends into the lifted viewBox) ---------- */}
        <rect x="0" y="-170" width="1640" height="492" fill="var(--sv-wall)" />
        <rect x="0" y="322" width="1640" height="534" fill="var(--sv-floor)" />
        <line x1="0" y1="322" x2="1640" y2="322" stroke={SK} stroke-width="2.5" />
        <rect x="0" y="322" width="1640" height="16" fill="var(--sv-skirt)" />

        <g class="floorlines" clip-path="url(#floorclip)" stroke="var(--sv-floorline)" stroke-width="1.5" fill="none">
          <path d={floorGrid} />
        </g>

        {/* window + painting high on the wall, pushed to the outer edges so the
            centred headline never collides with them. */}
        <g class="wall-art" transform="translate(0 -135)">
        {/* window — shifted left for clearance */}
        <g class="window" transform="translate(-55 10)">
          <rect x="118" y="44" width="288" height="212" rx="6" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
          <rect x="126" y="52" width="272" height="196" rx="4" fill="var(--sv-night)" />
          <g clip-path="url(#pane)" class="stars" fill="var(--sv-star)">
            <circle class="moonhalo" cx="340" cy="88" r="17" opacity="0.16" />
            <circle cx="340" cy="88" r="9" opacity="0.9" />
            <circle class="st" style="--d:-0.4s; --t:3.2s" cx="172" cy="94" r="2.6" />
            <circle class="st" style="--d:-1.7s; --t:4.1s" cx="248" cy="72" r="2" />
            <circle class="st" style="--d:-2.6s; --t:3.6s" cx="316" cy="112" r="2.4" />
            <circle class="st" style="--d:-1.1s; --t:4.6s" cx="204" cy="150" r="1.8" />
            <circle class="st" style="--d:-3.3s; --t:3.9s" cx="360" cy="170" r="2" />
            <circle class="st" style="--d:-2.2s; --t:4.3s" cx="286" cy="176" r="2.2" />
            <g fill="var(--sv-city)">
              <rect x="134" y="196" width="34" height="52" />
              <rect x="176" y="168" width="26" height="80" />
              <rect x="210" y="204" width="40" height="44" />
              <rect x="258" y="180" width="30" height="68" />
              <rect x="296" y="212" width="44" height="36" />
              <rect x="348" y="186" width="28" height="62" />
            </g>
            {/* lit windows, blinking on and off in offset groups */}
            <g class="citylights">
              <g class="l1">
                <rect x="140" y="204" width="5" height="7" />
                <rect x="182" y="180" width="5" height="7" />
                <rect x="264" y="192" width="5" height="7" />
                <rect x="304" y="222" width="5" height="7" />
                <rect x="354" y="196" width="5" height="7" />
              </g>
              <g class="l2">
                <rect x="152" y="216" width="5" height="7" />
                <rect x="192" y="196" width="5" height="7" />
                <rect x="218" y="214" width="5" height="7" />
                <rect x="274" y="208" width="5" height="7" />
                <rect x="318" y="230" width="5" height="7" />
              </g>
              <g class="l3">
                <rect x="140" y="228" width="5" height="7" />
                <rect x="182" y="212" width="5" height="7" />
                <rect x="232" y="224" width="5" height="7" />
                <rect x="264" y="224" width="5" height="7" />
                <rect x="330" y="220" width="5" height="7" />
                <rect x="364" y="212" width="5" height="7" />
              </g>
            </g>
          </g>
          <line x1="262" y1="52" x2="262" y2="248" stroke="var(--sv-frame)" stroke-width="3" />
          <line x1="126" y1="150" x2="398" y2="150" stroke="var(--sv-frame)" stroke-width="3" />
          <rect x="104" y="256" width="316" height="14" rx="3" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
        </g>

        {/* framed print: landscape matte — sky + hills, always readable in dark */}
        <g class="poster" transform="translate(70 0)">
          <rect x="1268" y="60" width="220" height="190" rx="5" fill="var(--sv-frame)" stroke={SK} stroke-width="3" />
          <rect x="1282" y="74" width="192" height="162" fill="var(--sv-furn-1)" />
          <g clip-path="url(#art)">
            <rect x="1282" y="74" width="192" height="100" fill="var(--sv-floor)" />
            <circle cx="1378" cy="118" r="36" fill={PRIM} stroke={SK} stroke-width="3.5" />
            <path
              d="M1288 236 C 1288 236 1305 188 1340 175 C 1375 162 1400 188 1410 236 Z"
              fill="var(--sv-leaf-2)"
              stroke={SK}
              stroke-width="3.5"
              stroke-linejoin="round"
            />
            <path
              d="M1355 236 C 1355 236 1380 178 1415 168 C 1450 158 1468 200 1470 236 Z"
              fill="var(--sv-leaf-1)"
              stroke={SK}
              stroke-width="3.5"
              stroke-linejoin="round"
            />
          </g>
          <rect x="1282" y="74" width="192" height="162" fill="none" stroke={SK} stroke-width="2" />
        </g>
        </g>

        {/* plant: leaves grow OUT of the soil, not from behind the pot */}
        <g class="plant" transform="translate(95 433) scale(0.85)">
          <polygon class="cast" points={potShadow} />
          <g class="unit pot">
            <polygon class="f-side" points={pot.side} />
            <polygon class="f-front" points={pot.front} />
            <polygon class="f-top" points={pot.top} />
          </g>
          <polygon points="0,16 38.1,38 0,60 -38.1,38" fill="var(--sv-seal-3)" />
          <g transform="translate(0 10)">
            <g class="sway" stroke={SK} stroke-width="3" stroke-linejoin="round">
              <path d="M0 26 C -34 -38, -22 -96, 6 -126 C 22 -80, 20 -20, 0 26 z" fill="var(--sv-leaf-1)" />
              <path d="M0 26 C -66 -8, -96 -52, -100 -90 C -58 -72, -20 -26, 0 26 z" fill="var(--sv-leaf-2)" />
              <path d="M0 26 C 54 -2, 86 -42, 92 -82 C 50 -66, 18 -22, 0 26 z" fill="var(--sv-leaf-2)" />
              <path d="M0 26 C 34 -38, 62 -74, 92 -88 C 74 -42, 38 2, 0 26 z" fill="var(--sv-leaf-1)" />
            </g>
          </g>
        </g>

        {/* ---------- ACT 1 · the desktop ---------- */}
        <g transform={`translate(${GX_L} ${GY}) scale(${S})`}>
          <polygon class="cast" points={frameShadow} />
          {frameFeet.map((f) => <polygon class="cast hard" points={f} />)}
          <polygon class="cast hard" points={towerShadow} />

          {/* the tower stands on the floor, under the desk, where a tower lives */}
          <g class="unit dev">
            <polygon class="f-side" points={towerPC.side} />
            <polygon class="f-front" points={towerPC.front} />
            <polygon class="f-top" points={towerPC.top} />
          </g>
