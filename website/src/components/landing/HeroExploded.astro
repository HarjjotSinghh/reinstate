  h1 {
    margin: clamp(0.75rem, 1.6vw, 1.1rem) auto 0;
    /* Fits "Restore your AI coding" / "workspace on any device" as exactly 2 lines */
    max-width: min(22ch, 100%);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.4vw, 3.85rem);
    line-height: 0.98;
