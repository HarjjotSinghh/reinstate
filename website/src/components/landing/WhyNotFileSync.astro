<style>
  .file-sync-section {
    --paper: #e4e7dd;
    --paper-2: #f4f6ef;
    --ink: oklch(0.19 0.022 158);
    --ink-2: oklch(0.41 0.018 158);
    --ink-3: oklch(0.54 0.014 158);
    --rule: oklch(0.8 0.012 145);
    --prim: oklch(0.87 0.21 128);
    --prim-deep: oklch(0.58 0.155 134);
    --on-prim: oklch(0.19 0.022 158);
    --sv-stroke: #131f1a;
    --sv-prim: #b8ff3c;
    --sv-prim-deep: #4f8a1e;
    --sv-shadow: #131f1a;
    --sv-furn-1: #c1c9ae;
    --sv-furn-2: #a6b090;
    --sv-furn-3: #8a9673;
    --sv-dev-0: #55685d;
    --sv-dev-1: #3b4c43;
    --sv-dev-2: #2a3831;
    --sv-dev-3: #1e2925;
    --sv-night: #16231f;
    --sv-t-c: #8fc8ea;

    position: relative;
    z-index: 1;
    isolation: isolate;
    overflow: clip;
    scroll-margin-top: 5rem;
    color: var(--ink);
  }
  :global(html.dark) .file-sync-section {
    --paper: #1d2723;
    --paper-2: #26332e;
    --ink: oklch(0.965 0.008 145);
    --ink-2: oklch(0.76 0.014 150);
    --ink-3: oklch(0.62 0.016 150);
    --rule: oklch(0.31 0.02 158);
    --prim: oklch(0.88 0.21 128);
    --prim-deep: oklch(0.84 0.19 128);
    --on-prim: oklch(0.17 0.04 132);
    --sv-stroke: #0d1613;
    --sv-prim: #c4ff56;
    --sv-prim-deep: #a8e83c;
    --sv-shadow: #050b09;
    --sv-furn-1: #6d8073;
    --sv-furn-2: #56685c;
    --sv-furn-3: #435248;
    --sv-dev-0: #6b7e72;
    --sv-dev-1: #52655a;
    --sv-dev-2: #3d4e45;
    --sv-dev-3: #2e3c34;
    --sv-night: #0a1310;
    --sv-t-c: #78b3da;
  }

  .file-sync-shell {
    position: relative;
    z-index: 2;
    max-width: 82rem;
    margin-inline: auto;
    padding: clamp(4rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem)
      clamp(4.5rem, 8vw, 7rem);
  }
  .file-sync-lede {
    display: grid;
    justify-items: center;
    max-width: 58rem;
    margin-inline: auto;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.36rem 0.85rem 0.36rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper-2) 94%, transparent);
    font-size: 0.78rem;
    font-weight: 550;
    color: var(--ink-2);
  }
  .badge i,
  .support-label i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sv-prim-deep);
  }
  .file-sync-lede h2 {
    margin: clamp(0.9rem, 1.8vw, 1.25rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.047em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .file-sync-lede p {
    max-width: 60rem;
    margin: 1.2rem auto 0;
    font-size: clamp(1rem, 0.55vw + 0.91rem, 1.17rem);
    line-height: 1.58;
    color: color-mix(in oklab, var(--ink) 28%, var(--ink-2));
    text-wrap: pretty;
  }

  .identity-proof {
    position: relative;
    z-index: 2;
    margin: clamp(5.25rem, 8vw, 6.75rem) auto 0;
    border: 2px solid var(--sv-stroke);
    border-radius: 15px;
    overflow: hidden;
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  .identity-proof__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.45rem 1.6rem 1.35rem;
    border-bottom: 1px solid var(--rule);
  }
  .proof-eyebrow {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    color: var(--sv-prim-deep);
  }
  .identity-proof h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .raw-sync-status {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 0.45rem;
    min-height: 1.9rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }
  .raw-sync-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .path-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem minmax(0, 1fr);
    align-items: stretch;
  }
  .path-side {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 1.55rem 1.6rem 1.6rem;
  }
  .path-side__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.15rem;
  }
  .path-side__head div {
    display: grid;
    gap: 0.08rem;
  }
  .path-side__head strong {
    font-size: 0.9rem;
    font-weight: 650;
  }
  .path-side__head div > span {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    color: var(--ink-3);
  }
  .repo-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    margin-left: auto;
    padding: 0.28rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--sv-prim-deep) 34%, var(--rule));
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper-2) 62%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .repo-chip i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sv-prim-deep);
  }
  .os-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid color-mix(in oklab, var(--sv-prim-deep) 52%, var(--rule));
    border-radius: 8px;
    background: color-mix(in oklab, var(--paper-2) 80%, var(--sv-prim) 12%);
    color: var(--sv-prim-deep);
  }
  .os-mark svg {
    display: block;
    width: 1.18rem;
    height: 1.18rem;
    fill: currentColor;
  }
  .os-mark--mac svg {
    width: 0.92rem;
    height: 1.15rem;
  }
  .path-row {
    display: grid;
    gap: 0.28rem;
  }
  .path-row > span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .path-row code {
    min-width: 0;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 7px;
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.75vw, 0.83rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
    color: var(--ink);
  }
  .path-row--key code {
    color: var(--sv-prim-deep);
  }
  .index-location {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.55rem;
    margin-top: 0.05rem;
    padding: 0.65rem 0.72rem;
    border: 1px dashed color-mix(in oklab, var(--sv-prim-deep) 30%, var(--rule));
    border-radius: 7px;
    background: color-mix(in oklab, var(--paper-2) 48%, transparent);
    color: var(--ink-3);
  }
  .index-location > svg {
    width: 1rem;
    height: 1rem;
    margin-top: 0.08rem;
    fill: none;
    stroke: var(--sv-prim-deep);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .index-location > span {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }
  .index-location code {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 450;
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
    overflow-wrap: anywhere;
    color: var(--ink-2);
  }
  .copy-crossing {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.55rem;
  }
  .copy-line {
    position: absolute;
    inset: 0 50%;
    width: 1px;
    background: var(--rule);
  }
  .copy-icon,
  .copy-label {
    position: relative;
    z-index: 1;
    background: color-mix(in oklab, var(--paper-2) 86%, transparent);
  }
  .copy-icon {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
  }
  .copy-icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy-label {
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-3);
  }
  .copy-label--mismatch {
    border: 1px solid color-mix(in oklab, var(--sv-prim-deep) 38%, var(--rule));
    background: color-mix(in oklab, var(--paper-2) 70%, var(--sv-prim) 7%);
    font-weight: 650;
    color: var(--sv-prim-deep);
  }

  .failed-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem 1.25rem;
    padding: 0.9rem 1.5rem;
    border-top: 1px solid var(--rule);
    background: color-mix(in oklab, var(--paper) 68%, transparent);
  }
  .result-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .result-chip svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .result-chip code {
    font-family: var(--font-mono);
  }
  .result-chip--ok {
    color: var(--sv-prim-deep);
  }
  .result-chip--bad {
    color: var(--ink-2);
  }

  .reinstate-map {
    display: grid;
    grid-template-columns: auto 1fr auto 1.4fr auto 0.75fr;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.2rem;
    border-top: 2px solid var(--sv-stroke);
    background: var(--sv-night);
    color: #f4f6ef;
  }
  .reinstate-map__brand {
    --paper: var(--sv-night);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-right: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: var(--sv-prim);
  }
  :global(.reinstate-map__brand .logo-mark) {
    width: 1.7rem;
    height: 1.7rem;
  }
  .map-transition {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border: 1px solid #34443d;
    border-radius: 7px;
    background: #101b17;
    color: var(--sv-prim);
  }
  .map-transition svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map-step {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }
  .map-step span {
    font-size: 0.62rem;
    color: #aebbb4;
  }
  .map-step code,
  .map-step strong {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    font-weight: 600;
    color: #f4f6ef;
    overflow-wrap: anywhere;
  }
  .map-step--result strong {
    color: var(--sv-prim);
  }
  .reason-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .reason-card {
    min-width: 0;
    padding: 1.3rem 1.25rem 1.4rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: color-mix(in oklab, var(--paper-2) 72%, transparent);
    text-wrap: pretty;
  }
  .reason-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .reason-icon {
    display: grid;
    place-items: center;
    width: 2.55rem;
    height: 2.55rem;
    border: 1.5px solid color-mix(in oklab, var(--sv-prim-deep) 48%, var(--rule));
    border-radius: 9px;
    color: var(--sv-prim-deep);
    background: color-mix(in oklab, var(--paper-2) 78%, var(--sv-prim) 14%);
  }
  .reason-icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .reason-k {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sv-prim-deep);
  }
  .reason-card h3 {
    margin: 0.95rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.5vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .reason-card p {
    margin: 0.55rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--ink) 30%, var(--ink-2));
  }

  .support-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: 11px;
    background: color-mix(in oklab, var(--paper-2) 76%, transparent);
  }
  .support-list,
  .support-rail nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }
  .support-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.9rem;
    padding: 0.3rem 0.55rem 0.3rem 0.42rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: color-mix(in oklab, var(--paper) 75%, transparent);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    color: var(--ink-2);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--sv-prim-deep);
  }
  .brand-mark svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .brand-pair {
    display: inline-flex;
    align-items: center;
  }
  .brand-pair .brand-mark + .brand-mark {
    margin-left: -0.14rem;
    padding-left: 0.14rem;
    border-left: 1px solid var(--rule);
  }
  .brand-mark--apple {
    width: 0.88rem;
  }
  .support-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-right: 0.2rem;
    font-size: 0.73rem;
    font-weight: 650;
    color: var(--ink);
  }
  .support-rail nav {
    flex: none;
  }
  .support-rail a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }
  .support-rail a:hover {
    color: var(--sv-prim-deep);
  }
  .support-rail a svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .support-rail a:hover svg {
    transform: translateX(2px);
  }

  :global(html.dark) .identity-proof {
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
  }
  :global(html.dark) .copy-icon,
  :global(html.dark) .copy-label {
    background: color-mix(in oklab, var(--paper-2) 82%, transparent);
  }
  :global(html.dark) .copy-label--mismatch {
    background: color-mix(in oklab, var(--paper-2) 70%, var(--sv-prim) 8%);
  }
  :global(html.dark) .reason-card,
  :global(html.dark) .support-rail {
    background: color-mix(in oklab, var(--paper-2) 78%, transparent);
  }
  :global(html.dark) .os-mark,
  :global(html.dark) .reason-icon {
    border-color: color-mix(in oklab, var(--sv-prim) 52%, var(--rule));
    background: color-mix(in oklab, var(--sv-night) 80%, var(--sv-prim) 12%);
    color: var(--sv-prim);
  }

  @media (max-width: 980px) {
    .identity-proof {
      margin-top: 5.5rem;
    }
    .path-pair {
      grid-template-columns: 1fr;
    }
    .copy-crossing {
      min-height: 4.2rem;
    }
    .copy-line {
      inset: 0 50%;
    }
    .copy-icon svg {
      transform: rotate(90deg);
    }
    .repo-chip {
      margin-left: auto;
    }
    .reinstate-map {
      grid-template-columns: 1fr auto 1fr;
    }
    .reinstate-map__brand {
      grid-column: 1 / -1;
      padding-bottom: 0.55rem;
      border-bottom: 1px solid #34443d;
    }
    .map-step--result {
      grid-column: 3;
    }
    .reason-grid {
      grid-template-columns: 1fr;
    }
    .support-rail {
      align-items: flex-start;
      flex-direction: column;
    }
    .support-rail nav {
      flex: initial;
    }
  }

  @media (max-width: 760px) {
    .file-sync-shell {
