---
/**
 * Final objection section before the install CTA.
 *
 * File sync moves bytes; Reinstate restores the native identity those bytes
 * need on the destination machine. The Claude key examples are synthetic and
 * intentionally mirror the adapter's documented absolute-path behavior.
 */
import PathMismatchEdgeArt from './art/PathMismatchEdgeArt.astro';
import LogoMark from '../LogoMark.astro';

const reasons = [
  {
    k: '01',
    title: 'File sync owns bytes',
    body:
      'Dropbox, iCloud, and rsync can copy the files perfectly while leaving destination-specific session identity untouched.',
    icon: 'files',
  },
  {
    k: '02',
    title: 'Reinstate owns identity',
    body:
      'A canonical project ID survives the trip. Restore rebuilds Claude’s project key or rewrites Codex’s structural working directory.',
    icon: 'route',
  },
  {
    k: '03',
    title: 'Native resume stays native',
    body:
      'Claude resumes Claude sessions; Codex resumes Codex rollouts. Reinstate never hides lossy cross-agent translation behind sync.',
    icon: 'resume',
  },
] as const;

const icons: Record<(typeof reasons)[number]['icon'], string> = {
  files: 'M7 3.5h7l4 4V20H7zM14 3.5V8h4M4 7v13h10',
  route: 'M5 6h5M14 6h5M7.5 3.5v5M16.5 3.5v5M7.5 8.5v3.5c0 2.2 1.8 4 4 4h5M14 13.5l3 2.5-3 2.5',
  resume: 'M5 8v5h5M6.5 12.5A7 7 0 1 0 8 6.2M13 8v4l3 2',
};
---

<section class="file-sync-section" id="why-not-file-sync" aria-labelledby="file-sync-title">
  <PathMismatchEdgeArt />

  <div class="file-sync-shell">
    <header class="file-sync-lede">
      <span class="badge"><i aria-hidden="true"></i> Why not Dropbox, iCloud, or rsync?</span>
      <h2 id="file-sync-title">
        Files can sync.<br />
        Native resume can still fail.
      </h2>
      <p>
        Agent histories are indexed by more than their bytes. Absolute paths become native
        identity, so Windows and macOS can treat the same repository as two different projects.
      </p>
    </header>

    <article class="identity-proof" aria-labelledby="identity-proof-title">
      <header class="identity-proof__head">
        <div>
          <span class="proof-eyebrow">CLAUDE CODE EXAMPLE</span>
          <h3 id="identity-proof-title">Same repository. Two native project keys.</h3>
        </div>
        <span class="raw-sync-status"><i aria-hidden="true"></i> RAW FILE SYNC</span>
      </header>

      <div class="path-pair">
        <section class="path-side" aria-label="Windows native project identity">
          <div class="path-side__head">
            <span class="os-mark os-mark--windows" aria-hidden="true">
              {/* Windows 11 mark geometry from Microsoft's published vector. */}
              <svg viewBox="0 0 48.746 48.746">
                <rect x="0" y="0" width="23.105" height="23.105"></rect>
                <rect x="25.642" y="0" width="23.105" height="23.105"></rect>
                <rect x="0" y="25.642" width="23.105" height="23.105"></rect>
                <rect x="25.642" y="25.642" width="23.105" height="23.105"></rect>
              </svg>
            </span>
            <div>
              <strong>Windows</strong>
              <span>source machine</span>
            </div>
            <span class="repo-chip"><i aria-hidden="true"></i> same repo · api</span>
          </div>
          <div class="path-row">
            <span>project root</span>
            <code>C:\Users\harjot\projects\api</code>
          </div>
          <div class="path-row path-row--key">
            <span>native project key</span>
            <code>C--Users-harjot-projects-api</code>
          </div>
          <div class="index-location">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 6.5h6l2 2H20.5v9.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"></path>
            </svg>
            <span>
              Claude index
              <code>~/.claude/projects/C--Users-harjot-projects-api/</code>
            </span>
          </div>
        </section>

        <div class="copy-crossing" aria-hidden="true">
          <span class="copy-line"></span>
          <span class="copy-label">same files</span>
          <span class="copy-icon">
            <svg viewBox="0 0 24 24">
              <path d="M5 12h12m0 0-4-4m4 4-4 4"></path>
            </svg>
          </span>
          <span class="copy-label copy-label--mismatch">≠ different keys</span>
        </div>

        <section class="path-side" aria-label="macOS native project identity">
          <div class="path-side__head">
            <span class="os-mark os-mark--mac" aria-hidden="true">
              {/* Apple mark geometry from the published Apple Logo vector. */}
              <svg viewBox="0 0 814 1000">
                <path
                  d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
                ></path>
              </svg>
            </span>
            <div>
              <strong>macOS</strong>
              <span>destination machine</span>
            </div>
            <span class="repo-chip"><i aria-hidden="true"></i> same repo · api</span>
          </div>
          <div class="path-row">
            <span>project root</span>
            <code>/Users/harjot/dev/api</code>
          </div>
          <div class="path-row path-row--key">
            <span>native project key</span>
            <code>-Users-harjot-dev-api</code>
          </div>
          <div class="index-location">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 6.5h6l2 2H20.5v9.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"></path>
            </svg>
            <span>
              Claude index
              <code>~/.claude/projects/-Users-harjot-dev-api/</code>
            </span>
          </div>
        </section>
      </div>

      <div class="failed-result">
        <span class="result-chip result-chip--ok">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3 3 7-7"></path></svg>
          Files copied
        </span>
        <span class="result-chip result-chip--bad">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8m0-8-8 8"></path></svg>
          <code>--resume</code>: no matching project
        </span>
      </div>

      <div class="reinstate-map">
        <span class="reinstate-map__brand">
          <LogoMark size={27} tiled={false} />
          REINSTATE
        </span>
        <div class="map-step">
          <span>canonical project</span>
          <code>api</code>
        </div>
        <span class="map-transition map-transition--route" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="6" cy="6" r="2.25"></circle>
            <circle cx="18" cy="18" r="2.25"></circle>
            <path d="M6 8.25v3.25A3.5 3.5 0 0 0 9.5 15h5.25"></path>
          </svg>
        </span>
        <div class="map-step">
          <span>destination root</span>
          <code>/Users/harjot/dev/api</code>
        </div>
        <span class="map-transition map-transition--identity" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M8.2 18.5a9.3 9.3 0 0 1-1.3-4.8 5.1 5.1 0 0 1 10.2 0c0 1.7-.3 3.3-.9 4.8"></path>
            <path d="M10.2 19.5a12 12 0 0 1-.9-5.3 2.7 2.7 0 0 1 5.4 0c0 2-.3 4-.9 5.8"></path>
            <path d="M12 4.2a9 9 0 0 0-8 5M20 9.2a9 9 0 0 0-4.4-4.1M12 12.5v7.3"></path>
          </svg>
        </span>
        <div class="map-step map-step--result">
          <span>native identity</span>
          <strong>rebuilt</strong>
        </div>
      </div>
    </article>

    <div class="reason-grid" role="list">
      {
        reasons.map((reason) => (
          <article class="reason-card" role="listitem">
            <div class="reason-card__head">
              <span class="reason-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={icons[reason.icon]}></path></svg>
              </span>
              <span class="reason-k" aria-hidden="true">{reason.k}</span>
            </div>
            <h3>{reason.title}</h3>
            <p>{reason.body}</p>
          </article>
        ))
      }
    </div>

    <footer class="support-rail">
      <div class="support-list" aria-label="Available now">
        <span class="support-label"><i aria-hidden="true"></i> Available now</span>
