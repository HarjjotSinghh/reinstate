---
/**
 * Security section: continues the office floor from problem/proof.
 * Signature: plaintext on the machine side of a seal, ciphertext in your bucket.
 * Design rules: website/AGENTS.md axonometric solids, near-black outlines,
 * no blur/shadow, light default + dark twin tokens.
 */
import { box, fmt, P } from '../../lib/iso';

const foot = (x: number, y: number, z: number, w: number, d: number) =>
  fmt([P(x, y, z), P(x + w, y, z), P(x + w, y + d, z), P(x, y + d, z)]);

const CX = Math.cos(Math.PI / 6);
const m2 = (m: number[]) => `matrix(${m.map((n) => +n.toFixed(2)).join(' ')})`;
/** Map 2D content onto the +y (front) face. Origin = top of face at x-min. */
const frontText = (x: number, y: number, z: number, d: number, h: number) => {
  const [e, f] = P(x, y + d, z + h);
  return m2([CX, 0.5, 0, 1, e, f]);
};
/** Map 2D content onto the +x (right) face. Origin = top of face at +y (front).
 *  Basis has positive det so type stays upright (not mirrored/flipped). */
const sideText = (
  x: number,
  y: number,
  z: number,
  w: number,
  d: number,
  h: number,
) => {
  const [e, f] = P(x + w, y + d, z + h);
  // local u → −y (front→back along face), local v → screen-down ≈ −z
  return m2([CX, -0.5, 0, 1, e, f]);
};
/** Map 2D content onto the top face. Origin = top at (x, y, z+h). */
const topText = (
  x: number,
  y: number,
  z: number,
  w: number,
  d: number,
  h: number,
) => {
  const [e, f] = P(x, y, z + h);
  // local u → +x, local v → +y (along the top diamond)
  return m2([CX, 0.5, -CX, 0.5, e, f]);
};

const layerNames = ['PATHS', 'METADATA', 'MESSAGES', 'SESSION'];
const tones = ['d', 'c', 'b', 'a'] as const;

/* ---- stage A · full Windows desk (mirrors terminal-proof density) ---- */
const srcPlatform = box(-280, -90, -12, 560, 180, 26);
const srcTower = box(-240, -60, 14, 76, 76, 148);
const srcMonitorFoot = box(-68, -48, 14, 120, 34, 8);
const srcMonitorStem = box(-18, -48, 22, 20, 14, 38);
const srcMonitorPanel = box(-128, -48, 60, 240, 14, 126);
const srcDock = box(117, -48, 14, 152, 92, 10);
const srcKeyboard = box(-130, 24, 14, 116, 38, 7);
const srcKeyRows = [
  foot(-120, 29, 21.2, 96, 5),
  foot(-120, 36, 21.2, 96, 5),
  foot(-120, 43, 21.2, 76, 5),
];
const srcMouse = box(4, 30, 14, 26, 32, 9);
const srcStack = [
  box(130, -38, 24, 128, 72, 16),
  box(130, -38, 40, 128, 72, 16),
  box(130, -38, 56, 128, 72, 16),
  box(130, -38, 72, 128, 72, 16),
];
const srcShadow = foot(-280, -90, -12, 560, 180);

/* ---- stage B · age seal (the trust boundary) ---- */
const sealPlinth = box(-86, -86, -24, 172, 172, 24);
const sealCube = box(-58, -58, 0, 116, 116, 112);
const sealShadow = foot(-86, -86, -24, 172, 172);
const sealInset = foot(-42, -42, 112.2, 84, 84);

/* ---- stage C · open vault cabinet (hollow) · ciphertext inside ---- */
const bucketPlatform = box(-140, -80, -12, 320, 170, 22);
/* open shell: back + side walls + floor; no front face so interior reads hollow */
const bucketBack = box(-90, -50, 14, 200, 14, 96);
const bucketWallL = box(-90, -50, 14, 14, 120, 96);
const bucketWallR = box(96, -50, 14, 14, 120, 96);
const bucketFloor = box(-90, -50, 14, 200, 120, 10);
const bucketRoof = box(-90, -50, 100, 200, 120, 10);
/* door swung open on the +y (near) edge */
const bucketDoor = box(-85, 72, 22, 12, 78, 78);
/* crates inside shell, mid-forward (not at the door, not against the back) */
const cipherCrates = [
  box(-60, -14, 28, 68, 42, 22),
  box(14, -10, 28, 64, 40, 22),
  box(-40, -6, 50, 74, 44, 20),
  box(-12, -2, 70, 58, 38, 18),
];
const bucketShadow = foot(-140, -80, -12, 320, 170);

/* ---- stage D · restored MacBook ---- */
const dstPlatform = box(-210, -80, -12, 420, 160, 26);
const dstDeck = box(-102, -48, 14, 204, 108, 16);
const dstHinge = box(-102, -58, 30, 204, 10, 10);
const dstLid = box(-98, -60, 40, 196, 10, 112);
const dstKeyboardWell = foot(-82, 28, 30.2, 164, 28);
const dstKeyRows = [
  foot(-72, 32, 30.4, 144, 4.5),
  foot(-72, 38.5, 30.4, 144, 4.5),
  foot(-72, 45, 30.4, 112, 4.5),
];
const dstTrackpad = foot(46, 45, 30.5, 26, 8);
const dstStack = [
  box(-62, -34, 30, 124, 58, 14),
  box(-62, -34, 44, 124, 58, 14),
  box(-62, -34, 58, 124, 58, 14),
  box(-62, -34, 72, 124, 58, 14),
];
const dstShadow = foot(-210, -80, -12, 420, 160);

/* ---- scenery · sparse props that touch the pipeline (no giant floor slab) ---- */
const safeBody = box(0, 0, 0, 100, 80, 120);
const safeDoor = box(8, 72, 18, 10, 60, 90);
const safeHandle = box(42, 78, 55, 16, 8, 16);

/* sealed packets · small stack by the age seal */
const packets = [
  box(0, 0, 0, 54, 38, 8),
  box(8, 6, 8, 50, 34, 8),
  box(4, 10, 16, 48, 32, 8),
];
const packetShadow = foot(0, 0, 0, 62, 48);

/* backup drives · tucked at the laptop platform edge */
const drives = [
  box(0, 0, 0, 52, 38, 14),
  box(4, 4, 14, 48, 34, 14),
  box(8, 8, 28, 44, 30, 14),
];
const driveShadow = foot(0, 0, 0, 56, 44);

const plantPot = box(0, 0, 0, 40, 40, 24);
/* leaf paths centered on (0,0); placed at pot top center */
const plantLeaves = [
  'M0 4 C -14 -18, -18 -40, -2 -58 C 8 -34, 10 -6, 0 4 Z',
  'M0 4 C 16 -16, 28 -36, 22 -56 C 8 -34, 4 -6, 0 4 Z',
  'M0 4 C -8 -22, 8 -42, 0 -60 C -6 -40, -4 -12, 0 4 Z',
];

const SK = 'var(--sv-stroke)';

const points = [
  {
    k: '01',
    title: 'Local encryption',
    body: 'Encrypted on-device with age before anything is uploaded.',
    icon: 'lock',
  },
  {
    k: '02',
    title: 'Your storage',
    body: 'Ciphertext lands in your own S3 or R2 bucket.',
    icon: 'bucket',
  },
  {
    k: '03',
    title: 'Your keys',
    body: 'The passphrase never leaves your devices. Lose it, data stays sealed.',
    icon: 'key',
  },
  {
    k: '04',
    title: 'No Reinstate servers',
    body: 'No account, no telemetry, no hosted copy of your sessions.',
    icon: 'ghost',
  },
  {
    k: '05',
    title: 'No auth tokens',
    body: 'API keys and OAuth tokens never sync. Credentials stay denylisted.',
    icon: 'shield',
  },
  {
    k: '06',
    title: 'Open-source client',
    body: 'Apache-2.0. Read the encryption path and every file we touch.',
    icon: 'code',
  },
  {
    k: '07',
    title: 'Fail-safe restore',
    body: 'Timestamped backups, conflict forks, atomic writes.',
    icon: 'backup',
  },
  {
    k: '08',
    title: 'TLS in transit',
    body: 'Already encrypted, then HTTPS to your bucket. No plaintext on the wire.',
    icon: 'wire',
  },
] as const;

const icons: Record<(typeof points)[number]['icon'], string> = {
  lock: 'M7 10V8a5 5 0 0 1 10 0v2M6 10h12v10H6zM12 14v3',
  bucket: 'M4 8h16l-1.2 12H5.2L4 8zM8 8V6a4 4 0 0 1 8 0v2M9 13h6',
  key: 'M8 14a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm3.5-2.5L20 20m-3-3 3 3',
  ghost: 'M5 10a7 7 0 0 1 14 0v9l-2.5-1.5L14 19l-2-1.5L10 19 7.5 17.5 5 19z',
  shield: 'M12 3.5 19 6v5.2c0 4.1-2.8 7.5-7 9.3-4.2-1.8-7-5.2-7-9.3V6l7-2.5zM9.5 12l1.8 1.8L15 10',
  code: 'M8 8 4 12l4 4M16 8l4 4-4 4M13 6l-2 12',
  backup: 'M4 7h12v12H4zM8 7V5h12v12h-2M8 12h4M8 15h6',
  wire: 'M4 12h6m4 0h6M10 12a2 2 0 1 1 4 0 2 2 0 0 1-4 0zM7 9v6M17 9v6',
};
---

<section class="security-section" id="security" aria-labelledby="security-title">
  <div class="security-shell">
    <header class="security-lede">
      <span class="badge"><i aria-hidden="true"></i> Trust · ownership · open source</span>
      <h2 id="security-title">
        <span class="h2-line">Sessions leave encrypted.</span>
        <span class="h2-line">Your bucket never sees plaintext.</span>
      </h2>
      <p class="sub">
        Your sessions can contain source code and private work. Reinstate encrypts them
        locally before storage.<br />
        Your bucket holds ciphertext. Only your devices hold the keys that restore it.
      </p>
    </header>

    <figure class="security-scene">
      <svg
        class="security-art"
        viewBox="-170 12 1820 470"
        role="img"
        aria-labelledby="sec-title sec-desc"
        preserveAspectRatio="xMidYMid meet"
      >
        <title id="sec-title">Local encryption before your bucket</title>
        <desc id="sec-desc">
          A Windows workstation seals session layers into an age cube, stores ciphertext
          crates in your bucket, then restores them on a MacBook. A vault safe, sealed
          packets, backup drives, and a plant frame the pipeline.
        </desc>

        <defs>
          <marker
            id="sec-arrow"
            viewBox="0 0 12 12"
            refX="9"
            refY="6"
            markerWidth="5"
            markerHeight="5"
            orient="auto"
          >
            <path d="M0 0 L12 6 L0 12 z" fill="var(--sv-prim-deep)"></path>
          </marker>
        </defs>

        {/* Mild zoom; pipeline centered under the lede */}
        <g transform="translate(710 230) scale(1.18) translate(-730 -230)">

        {/* vault safe · left of the Windows desk, stepped forward so it reads clearly */}
        <g transform="translate(55 255) scale(0.52)">
          <polygon class="cast" points={foot(0, 0, 0, 100, 80)}></polygon>
          <g class="unit sealbox">
            <polygon class="f-side" points={safeBody.side}></polygon>
            <polygon class="f-front" points={safeBody.front}></polygon>
            <polygon class="f-top" points={safeBody.top}></polygon>
          </g>
          <g class="unit device">
            <polygon class="f-side" points={safeDoor.side}></polygon>
            <polygon class="f-front" points={safeDoor.front}></polygon>
            <polygon class="f-top" points={safeDoor.top}></polygon>
          </g>
          <g class="unit board">
            <polygon class="f-side" points={safeHandle.side}></polygon>
            <polygon class="f-front" points={safeHandle.front}></polygon>
            <polygon class="f-top" points={safeHandle.top}></polygon>
          </g>
          <circle
            cx={P(55, 40, 62)[0]}
            cy={P(55, 40, 62)[1]}
            r="7"
            fill="var(--sv-prim)"
            stroke={SK}
            stroke-width="2.2"
          ></circle>
        </g>

        {/* ---- 01 source workstation ---- */}
        <g transform="translate(260 275) scale(0.68)">
          <polygon class="cast" points={srcShadow}></polygon>
          <g class="unit platform">
            <polygon class="f-side" points={srcPlatform.side}></polygon>
            <polygon class="f-front" points={srcPlatform.front}></polygon>
            <polygon class="f-top" points={srcPlatform.top}></polygon>
          </g>
          <g class="unit device">
            <polygon class="f-side" points={srcTower.side}></polygon>
            <polygon class="f-front" points={srcTower.front}></polygon>
            <polygon class="f-top" points={srcTower.top}></polygon>
          </g>
          <g class="tower-detail" transform={frontText(-240, -60, 14, 76, 148)}>
            <rect x="11" y="14" width="54" height="7" rx="3.5"></rect>
            <rect x="11" y="31" width="54" height="4" rx="2"></rect>
            <rect x="11" y="40" width="54" height="4" rx="2"></rect>
            <rect x="11" y="49" width="54" height="4" rx="2"></rect>
            <circle cx="19" cy="70" r="5"></circle>
            <rect class="tower-bay" x="11" y="92" width="54" height="38" rx="5"></rect>
            <circle class="tower-led pulse" cx="56" cy="116" r="3"></circle>
          </g>
          <g class="unit device board">
            <polygon class="f-side" points={srcMonitorFoot.side}></polygon>
            <polygon class="f-front" points={srcMonitorFoot.front}></polygon>
            <polygon class="f-top" points={srcMonitorFoot.top}></polygon>
          </g>
          <g class="unit device">
            <polygon class="f-side" points={srcMonitorStem.side}></polygon>
            <polygon class="f-front" points={srcMonitorStem.front}></polygon>
            <polygon class="f-top" points={srcMonitorStem.top}></polygon>
          </g>
          <g class="unit device">
            <polygon class="f-side" points={srcMonitorPanel.side}></polygon>
            <polygon class="f-front" points={srcMonitorPanel.front}></polygon>
            <polygon class="f-top" points={srcMonitorPanel.top}></polygon>
          </g>
          <g class="screen-detail" transform={frontText(-128, -48, 60, 14, 126)}>
            <polygon points="8,8 232,8 232,116 8,116"></polygon>
            <rect x="15" y="16" width="78" height="16" rx="8"></rect>
            <text x="54" y="28" text-anchor="middle">plaintext</text>
            <rect class="screen-line" x="15" y="50" width="188" height="6" rx="3"></rect>
            <rect class="screen-line" x="15" y="66" width="144" height="6" rx="3"></rect>
            <rect class="screen-cursor blink" x="168" y="65" width="7" height="9"></rect>
          </g>
          <g class="unit device board">
            <polygon class="f-side" points={srcDock.side}></polygon>
            <polygon class="f-front" points={srcDock.front}></polygon>
            <polygon class="f-top" points={srcDock.top}></polygon>
          </g>
          <g class="dock-detail" transform={frontText(117, -48, 14, 92, 10)}>
            <rect x="18" y="2" width="24" height="6" rx="2"></rect>
            <rect x="50" y="2" width="24" height="6" rx="2"></rect>
            <rect x="82" y="2" width="24" height="6" rx="2"></rect>
            <circle cx="136" cy="5" r="3"></circle>
          </g>
          {
            srcStack.map((layer, index) => (
              <g class={`unit tray t-${tones[index]}`}>
                <polygon class="f-side" points={layer.side}></polygon>
                <polygon class="f-front" points={layer.front}></polygon>
                <polygon class="f-top" points={layer.top}></polygon>
                <text
                  class="layer-label"
                  transform={frontText(130, -38, 24 + index * 16, 72, 16)}
                  x="64"
                  y="11.5"
                  text-anchor="middle"
                >
                  {layerNames[index]}
                </text>
              </g>
            ))
          }
          <g class="unit device board">
            <polygon class="f-side" points={srcKeyboard.side}></polygon>
            <polygon class="f-front" points={srcKeyboard.front}></polygon>
            <polygon class="f-top" points={srcKeyboard.top}></polygon>
          </g>
          <g class="key-lines">
            {srcKeyRows.map((row) => (
              <polygon points={row}></polygon>
            ))}
          </g>
          <g class="unit device board">
            <polygon class="f-side" points={srcMouse.side}></polygon>
            <polygon class="f-front" points={srcMouse.front}></polygon>
            <polygon class="f-top" points={srcMouse.top}></polygon>
          </g>
        </g>

        {/* session stack left face → arcs over the pile → seal cube left face */}
        <path
          class="flow-line flow-a"
          d="M 348 266 C 420 195, 520 165, 590 198"
          fill="none"
          marker-end="url(#sec-arrow)"
        ></path>

        {/* ---- 02 age seal ---- */}
        <g transform="translate(640 255) scale(0.72)">
          <polygon class="cast" points={sealShadow}></polygon>
          <g class="unit platform">
            <polygon class="f-side" points={sealPlinth.side}></polygon>
            <polygon class="f-front" points={sealPlinth.front}></polygon>
            <polygon class="f-top" points={sealPlinth.top}></polygon>
          </g>
          <g class="unit sealbox">
            <polygon class="f-side" points={sealCube.side}></polygon>
            <polygon class="f-front" points={sealCube.front}></polygon>
            <polygon class="f-top" points={sealCube.top}></polygon>
          </g>
          <polygon class="seal-inset" points={sealInset}></polygon>
          <g class="seal-detail" transform={frontText(-58, -58, 0, 116, 112)}>
            <rect x="22" y="28" width="72" height="34" rx="5"></rect>
            {/* compact lock · ~half prior size, centered in panel */}
            <g transform="translate(58 45) scale(0.5) translate(-58 -48)">
              <path d="M46 39 v-6 a12 12 0 0 1 24 0 v6"></path>
              <rect class="seal-lock" x="41" y="39" width="34" height="23" rx="5"></rect>
              <circle cx="58" cy="49" r="3"></circle>
              <path d="M58 52 v5"></path>
            </g>
            <rect class="seal-line" x="22" y="76" width="48" height="4" rx="2"></rect>
            <rect class="seal-line" x="22" y="85" width="32" height="4" rx="2"></rect>
          </g>
          {/* age plate · centered on the +x side face (iso-projected, upright) */}
          <g class="age-stamp" transform={sideText(-58, -58, 0, 116, 116, 112)}>
            {/* face 116×112; badge 50×24 → center */}
            <g transform="translate(33 44)">
              <rect width="50" height="24" rx="5"></rect>
              <text x="25" y="16" text-anchor="middle">age</text>
            </g>
          </g>
        </g>

        {/* sealed packets · small stack at the seal plinth edge */}
        <g transform="translate(555 285) scale(0.5)">
          <polygon class="cast" points={packetShadow}></polygon>
          {
            packets.map((p, i) => (
              <g class={`unit tray t-${i === 0 ? 'a' : i === 1 ? 'b' : 'c'}`}>
                <polygon class="f-side" points={p.side}></polygon>
                <polygon class="f-front" points={p.front}></polygon>
                <polygon class="f-top" points={p.top}></polygon>
              </g>
            ))
          }
          <g class="packet-seal" transform="translate(10 -18)">
            <rect width="28" height="14" rx="3"></rect>
            <text x="14" y="10" text-anchor="middle">age</text>
          </g>
        </g>

        {/* seal right face → open vault left */}
        <path
          class="flow-line flow-b"
          d="M 700 248 C 760 215, 825 215, 880 248"
          fill="none"
          marker-end="url(#sec-arrow)"
        ></path>

        {/* ---- 03 your bucket · open hollow vault ---- */}
        <g transform="translate(940 258) scale(0.68)">
          <polygon class="cast" points={bucketShadow}></polygon>
          <g class="unit platform">
            <polygon class="f-side" points={bucketPlatform.side}></polygon>
            <polygon class="f-front" points={bucketPlatform.front}></polygon>
            <polygon class="f-top" points={bucketPlatform.top}></polygon>
          </g>
          {/* hollow shell: back, walls, floor, roof; no front face */}
          <g class="unit sealbox">
            <polygon class="f-side" points={bucketBack.side}></polygon>
            <polygon class="f-front" points={bucketBack.front}></polygon>
            <polygon class="f-top" points={bucketBack.top}></polygon>
          </g>
          <g class="unit sealbox">
            <polygon class="f-side" points={bucketWallL.side}></polygon>
            <polygon class="f-front" points={bucketWallL.front}></polygon>
            <polygon class="f-top" points={bucketWallL.top}></polygon>
          </g>
          <g class="unit sealbox">
            <polygon class="f-side" points={bucketFloor.side}></polygon>
            <polygon class="f-front" points={bucketFloor.front}></polygon>
            <polygon class="f-top" points={bucketFloor.top}></polygon>
          </g>
          {/* crates sit on the floor inside the shell, before outer walls/roof */}
          {
            cipherCrates.map((c, i) => (
              <g class="unit cipher">
                <polygon class="f-side" points={c.side}></polygon>
                <polygon class="f-front" points={c.front}></polygon>
                <polygon class="f-top" points={c.top}></polygon>
                <text
                  class="cipher-mark"
                  transform={frontText(
                    i === 0 ? -60 : i === 1 ? 14 : i === 2 ? -40 : -12,
                    i === 0 ? -14 : i === 1 ? -10 : i === 2 ? -6 : -2,
                    i === 0 ? 28 : i === 1 ? 28 : i === 2 ? 50 : 70,
                    i < 2 ? 42 : i === 2 ? 44 : 38,
                    i < 3 ? 22 : 18,
                  )}
                  x="28"
                  y="14"
                  text-anchor="middle"
                >
                  ####
                </text>
              </g>
            ))
          }
          <g class="unit sealbox">
            <polygon class="f-side" points={bucketWallR.side}></polygon>
            <polygon class="f-front" points={bucketWallR.front}></polygon>
            <polygon class="f-top" points={bucketWallR.top}></polygon>
          </g>
          <g class="unit sealbox">
            <polygon class="f-side" points={bucketRoof.side}></polygon>
            <polygon class="f-front" points={bucketRoof.front}></polygon>
            <polygon class="f-top" points={bucketRoof.top}></polygon>
          </g>
          {/* label · flush on the roof top face (same treatment as age plate) */}
          <g class="bucket-chip" transform={topText(-90, -50, 100, 200, 120, 10)}>
            {/* roof top 200×120; larger badge for readable type */}
            <g transform="translate(28 36)">
              <rect width="144" height="36" rx="10"></rect>
              <text x="72" y="24" text-anchor="middle">your bucket</text>
            </g>
          </g>
          {/* open door (swung outward) */}
          <g class="unit device">
            <polygon class="f-side" points={bucketDoor.side}></polygon>
            <polygon class="f-front" points={bucketDoor.front}></polygon>
            <polygon class="f-top" points={bucketDoor.top}></polygon>
          </g>
          <circle
            cx={P(20, 30, 55)[0]}
            cy={P(20, 30, 55)[1]}
            r="5"
            fill="var(--sv-prim)"
            stroke="var(--sv-stroke)"
            stroke-width="2"
          ></circle>
        </g>

        {/* open vault right → laptop left edge */}
        <path
          class="flow-line flow-c"
          d="M 1040 252 C 1105 218, 1170 218, 1225 252"
          fill="none"
          marker-end="url(#sec-arrow)"
        ></path>

        {/* ---- 04 restored laptop ---- */}
        <g transform="translate(1300 275) scale(0.68)">
          <polygon class="cast" points={dstShadow}></polygon>
          <g class="unit platform">
            <polygon class="f-side" points={dstPlatform.side}></polygon>
            <polygon class="f-front" points={dstPlatform.front}></polygon>
            <polygon class="f-top" points={dstPlatform.top}></polygon>
          </g>
          {/* plant · on platform top, left of the MacBook */}
          <g
