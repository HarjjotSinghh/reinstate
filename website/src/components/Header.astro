---
import BrandLockup from './BrandLockup.astro';

const path = Astro.url.pathname;
const onHome = path === '/';
const onDocs = path.startsWith('/docs');
const onIntegrations = path.startsWith('/integrations');
const onSecurity = path === '/security';
---

<header class:list={['nav', onHome && 'is-home']}>
  <div class="nav-frame">
    <div class="shell nav-inner">
      <BrandLockup href="/" class="mark" size={36} tiled={false} />

      <nav class="links" aria-label="Primary">
        <a href="/#how">How it works</a>
        <a href="/integrations" class:list={[onIntegrations && 'is-active']}>Integrations</a>
        <a href="/docs/getting-started" class:list={[onDocs && 'is-active']}>Docs</a>
        <a href="/security" class:list={[onSecurity && 'is-active']}>Security</a>
        <a
          href="https://github.com/HarjjotSinghh/reinstate"
          data-analytics-event="github_click"
          data-analytics-target="header"
          rel="noopener noreferrer"
          target="_blank">GitHub</a
        >
      </nav>

      <div class="nav-end">
        <button class="themetoggle" id="themetoggle" type="button" aria-label="Switch colour theme">
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path
              d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"
            ></path>
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z"></path>
          </svg>
        </button>

        <a
          class="navcta"
          href="/docs/getting-started"
          data-analytics-event="docs_getting_started"
          data-analytics-target="header"
        >
          <span class="navcta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path class="navcta-arrow" d="M12 4v10m0 0-3.5-3.5M12 14l3.5-3.5"></path>
              <path class="navcta-tray" d="M5 17v1.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V17"></path>
            </svg>
          </span>
          <span class="navcta-label">Install Reinstate</span>
        </a>

        <button
          type="button"
          class="navburger"
          id="nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-nav" class="mobile-nav" hidden>
      <nav class="shell mobile-links" aria-label="Mobile">
        <a href="/#how">How it works</a>
        <a href="/integrations">Integrations</a>
        <a href="/docs/getting-started">Docs</a>
        <a href="/security">Security</a>
        <a
          href="https://github.com/HarjjotSinghh/reinstate"
          data-analytics-event="github_click"
          data-analytics-target="mobile-header"
          rel="noopener noreferrer"
          target="_blank"
          >GitHub</a
        >
      </nav>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('themetoggle');
  const navToggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const nav = document.querySelector('.nav');
  let navFrameRequested = false;

  const sync = () => {
    const dark = root.classList.contains('dark');
    toggle?.setAttribute('aria-pressed', String(dark));
    // Defined in BaseLayout boot script — recreates <link rel=icon> (href edits are ignored).
    if (typeof window.__reinSetFavicon === 'function') {
      window.__reinSetFavicon(dark);
    }
  };
  sync();

  const syncNavFrame = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 12);
    navFrameRequested = false;
  };

  const requestNavFrameSync = () => {
    if (navFrameRequested) return;
    navFrameRequested = true;
    window.requestAnimationFrame(syncNavFrame);
  };

  syncNavFrame();
  window.addEventListener('scroll', requestNavFrameSync, { passive: true });

  toggle?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('rein-theme', dark ? 'dark' : 'light');
    } catch {
      /* private mode */
    }
    sync();
  });

  navToggle?.addEventListener('click', () => {
    if (!mobileNav || !navToggle) return;
    const open = mobileNav.hasAttribute('hidden');
    if (open) {
      mobileNav.hidden = false;
      nav?.classList.add('is-open');
      navToggle.setAttribute('aria-expanded', 'true');
      navToggle.setAttribute('aria-label', 'Close menu');
    } else {
      mobileNav.hidden = true;
      nav?.classList.remove('is-open');
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.setAttribute('aria-label', 'Open menu');
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 0.75rem clamp(0.75rem, 2vw, 1.5rem) 0.6rem;
    background: transparent;
  }
  .nav-frame {
    max-width: 58rem;
    margin-inline: auto;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper-2);
    transition:
      background 0.18s ease,
      border-color 0.18s ease;
  }
  .nav.is-home:not(.is-scrolled):not(.is-open) .nav-frame {
    border-color: transparent;
    background: transparent;
  }
  /*
   * True geometric center for links: absolute midpoint of the bar.
   * Equal 1fr columns look off when the CTA is much wider than the brand.
   */
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    gap: 1rem;
    min-height: 3.75rem;
    /* Shell defaults are wide; keep the pill compact and even */
    padding-inline: 0.75rem;
  }
  .mark {
    position: relative;
    z-index: 1;
    flex: none;
    font-size: 1.36rem;
  }
  .links {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 1.25rem;
    font-size: 0.92rem;
    color: var(--ink-2);
    /* Stay above the bar, but under clickable brand/CTA edges if they ever meet */
    z-index: 0;
  }
  .links a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .links a:hover,
  .links a.is-active {
    color: var(--ink);
  }
  .nav-end {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex: none;
    gap: 0.5rem;
  }
  .themetoggle {
    display: grid;
    place-items: center;
    flex: none;
    box-sizing: border-box;
    width: 2.4rem;
    height: 2.4rem;
    min-width: 2.4rem;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: color-mix(in oklch, var(--ink) 8%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s,
      transform 0.14s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .themetoggle:hover {
    background: color-mix(in oklch, var(--ink) 14%, transparent);
    color: var(--ink);
  }
  .themetoggle:active {
    transform: scale(0.97);
  }
  .themetoggle svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }
  .i-moon {
    display: none;
  }
  :global(html.dark) .i-moon {
    display: block;
  }
  :global(html.dark) .i-sun {
    display: none;
  }
  .navcta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-sizing: border-box;
    height: 2.4rem;
    padding: 0 0.9rem 0 0.78rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.14s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.2s,
      color 0.2s,
      gap 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .navcta-arrow {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta-tray {
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta-label {
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta:hover {
    background: var(--prim);
    color: var(--on-prim);
    gap: 0.55rem;
  }
  .navcta:hover .navcta-icon {
    transform: translateY(1px);
  }
  .navcta:hover .navcta-arrow {
    animation: navcta-download 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navcta:hover .navcta-label {
    transform: translateX(1px);
  }
  .navcta:active {
    transform: scale(0.97);
  }
  .navcta:active .navcta-icon {
    transform: translateY(2px);
  }
  @keyframes navcta-download {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    45% {
      transform: translateY(3px);
      opacity: 0.35;
    }
    46% {
      transform: translateY(-4px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .navburger {
    display: none;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper-2);
    color: var(--ink);
    cursor: pointer;
  }
  .mobile-nav {
    border-top: 1px solid var(--rule);
    padding-block: 0.65rem;
  }
  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-links a {
    padding: 0.55rem 0;
    text-decoration: none;
    color: var(--ink-2);
  }
  .mobile-links a:hover {
    color: var(--ink);
  }
  @media (max-width: 940px) {
    .links {
      display: none;
    }
    .navburger {
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .nav-inner {
      gap: 0.55rem;
      padding-inline: 0.55rem;
    }
    .mark {
      font-size: 1.22rem;
    }
    .themetoggle {
      display: none;
    }
    .navcta {
      height: 2.25rem;
      padding-inline: 0.7rem 0.75rem;
      font-size: 0.84rem;
      gap: 0.34rem;
    }
    .navcta:hover {
      gap: 0.42rem;
    }
    .navburger {
      flex: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-frame {
      transition: none;
    }
    .navcta,
    .navcta-icon,
    .navcta-arrow,
    .navcta-tray,
    .navcta-label {
      transition: none;
      animation: none !important;
    }
    .navcta:hover .navcta-icon,
    .navcta:hover .navcta-arrow,
    .navcta:hover .navcta-label,
    .navcta:active .navcta-icon {
      transform: none;
    }
  }
</style>
