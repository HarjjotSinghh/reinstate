---
import {
  aiReferralRules,
  analyticsCampaigns,
  analyticsEvents,
  analyticsEventTargets,
  analyticsLinkRules,
  analyticsPageEvent,
  marketingReferralRules,
} from '../lib/analytics';

const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const scriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL;
const enabled = Boolean(domain && scriptUrl);
const pageEvent = analyticsPageEvent(Astro.url.pathname);
const analyticsConfig = JSON.stringify({
  pageEvent,
  events: analyticsEvents,
  eventTargets: analyticsEventTargets,
  linkRules: analyticsLinkRules,
  referralRules: aiReferralRules,
  marketingReferralRules,
  campaigns: analyticsCampaigns,
})
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

{
  enabled && (
    <script
      is:inline
      defer
      data-domain={domain}
      src={scriptUrl}
    />
  )
}
{
  enabled && (
    <script
      is:inline
      set:html={`
        var reinstateAnalytics = ${analyticsConfig};
        window.plausible = window.plausible || function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };

        function normalizedReferralHostname(value) {
          try {
            return new URL(value).hostname.toLowerCase().replace(/\\.$/, '');
          } catch (_) {
            return '';
          }
        }

        function resolveChannel(rules) {
          var trackingTokens = ['utm_source', 'utm_medium', 'utm_campaign']
            .map(function (key) {
              return new URL(window.location.href).searchParams.get(key);
            })
            .filter(Boolean)
            .map(function (value) {
              return value.trim().toLowerCase();
            });

          var utmRule = rules.find(function (rule) {
            return rule.utmTokens.some(function (expected) {
              return trackingTokens.some(function (value) {
                return value === expected;
              });
            });
          });
          if (utmRule) return utmRule.channel;

          var hostname = normalizedReferralHostname(document.referrer);
          if (!hostname) return '';
          var hostRule = rules.find(function (rule) {
            return rule.hostnames.some(function (expected) {
              return hostname === expected || hostname.endsWith('.' + expected);
            });
          });
          return hostRule ? hostRule.channel : '';
        }

        // utm_content is matched against a fixed allowlist rather than read
        // through, so an arbitrary query value can never be transmitted.
        function resolveCampaign() {
          var raw = new URL(window.location.href).searchParams.get('utm_content');
          if (!raw) return '';
          var value = raw.trim().toLowerCase();
          return reinstateAnalytics.campaigns.indexOf(value) === -1 ? '' : value;
        }

        var reinstateReferralChannel = resolveChannel(reinstateAnalytics.referralRules);
        var reinstateMarketingChannel = resolveChannel(reinstateAnalytics.marketingReferralRules);
        var reinstateCampaign = resolveCampaign();

        function sendReinstateEvent(name, target) {
          if (
            reinstateAnalytics.events.indexOf(name) === -1 ||
            !reinstateAnalytics.eventTargets[name] ||
            reinstateAnalytics.eventTargets[name].indexOf(target || '') === -1
          ) {
            return false;
          }
          var props = {
            location: window.location.pathname,
            target: target || ''
          };
          if (reinstateReferralChannel) {
            props.ai_referral_channel = reinstateReferralChannel;
          }
          if (reinstateMarketingChannel) {
            props.referral_channel = reinstateMarketingChannel;
          }
          if (reinstateCampaign) {
            props.campaign = reinstateCampaign;
          }
          window.plausible(name, {
            props: props
          });
          return true;
        }
        window.reinstateTrack = sendReinstateEvent;

        if (reinstateAnalytics.pageEvent) {
          sendReinstateEvent(
            reinstateAnalytics.pageEvent.event,
            reinstateAnalytics.pageEvent.target
          );
        }

        document.addEventListener('click', function (event) {
          var target = event.target instanceof Element
            ? event.target.closest('[data-analytics-event]')
            : null;

          if (target) {
            var declaredName = target.getAttribute('data-analytics-event');
            if (declaredName) {
              sendReinstateEvent(
                declaredName,
                target.getAttribute('data-analytics-target') || ''
              );
              return;
            }
          }

          var link = event.target instanceof Element
            ? event.target.closest('a[href]')
            : null;
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href === '/rss.xml' || href === 'https://reinstate.dev/rss.xml') {
            sendReinstateEvent('changelog_subscribe', 'rss-feed');
            return;
          }

          var rule = reinstateAnalytics.linkRules.find(function (candidate) {
            return href.indexOf(candidate.includes) !== -1;
          });
          if (rule) sendReinstateEvent(rule.event, rule.target);
        });
      `}
    />
  )
}
