---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { product, siteUrl } from '../data/product';
import {
  blogPostingSchema,
  breadcrumbSchema,
  howToSchema,
  techArticleSchema,
  webPageSchema,
  type Breadcrumb,
  type SchemaNode,
} from '../lib/schema';

interface RelatedLink {
  title: string;
  path: string;
}

interface Props {
  kind: 'guide' | 'blog';
  title: string;
  description: string;
  answer: string;
  path: string;
  author: string;
  publishedAt: Date;
  updatedAt: Date;
  reviewedAt: Date;
  tags: string[];
  noindex: boolean;
  breadcrumbs: Breadcrumb[];
  related: RelatedLink[];
  estimatedMinutes?: number;
  category: string;
}

const {
  kind,
  title,
  description,
  answer,
  path,
  author,
  publishedAt,
  updatedAt,
  reviewedAt,
  tags,
  noindex,
  breadcrumbs,
  related,
  estimatedMinutes,
  category,
} = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const articleSchema =
  kind === 'guide'
    ? techArticleSchema({
        path,
        title,
        description,
        publishedAt,
        updatedAt,
        tags,
      })
    : blogPostingSchema({
        path,
        title,
        description,
        publishedAt,
        updatedAt,
        tags,
      });

const guideEntry =
  kind === 'guide'
    ? (await getCollection('guides')).find(
        (entry) => `/guides/${entry.id.replace(/\.mdx?$/, '')}` === path,
      )
    : undefined;

if (kind === 'guide' && !guideEntry) {
  throw new Error(`Guide metadata was not found for ${path}.`);
}

const guidePrerequisites = guideEntry?.data.prerequisites ?? [];
const guideHowToSteps = guideEntry?.data.howToSteps ?? [];
const estimatedTaskMinutes = guideEntry?.data.estimatedTaskMinutes;

const schema: SchemaNode[] = [
  webPageSchema({ path, title, description, updatedAt }),
  articleSchema,
  breadcrumbSchema(breadcrumbs),
];

if (kind === 'guide' && estimatedTaskMinutes && guideHowToSteps.length > 0) {
  schema.push(
    howToSchema({
      path,
      title,
      description,
      estimatedTaskMinutes,
      steps: guideHowToSteps,
    }),
  );
}
---

<BaseLayout
  title={`${title} | Reinstate`}
  {description}
  canonical={siteUrl(path)}
  type="article"
  {noindex}
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  section={kind === 'guide' ? 'Guides' : 'Blog'}
  {tags}
  jsonLd={schema}
>
  <article class="editorial-page">
    <header class="editorial-hero">
      <div class="editorial-shell">
        <Breadcrumbs items={breadcrumbs} />
        <p class="eyebrow">{kind === 'guide' ? 'Practical guide' : category}</p>
        <h1>{title}</h1>
        <p class="direct-answer">{answer}</p>

        <dl class="article-meta">
          <div>
            <dt>By</dt>
            <dd><a href={product.maintainer.url} rel="author">{author}</a></dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></dd>
          </div>
          <div>
            <dt>Updated</dt>
            <dd><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></dd>
          </div>
          <div>
            <dt>Reviewed</dt>
            <dd><time datetime={reviewedAt.toISOString()}>{formatDate(reviewedAt)}</time></dd>
          </div>
          {
            estimatedMinutes && (
              <div>
                <dt>Reading time</dt>
                <dd>{estimatedMinutes} minutes</dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="editorial-shell editorial-grid">
      <aside class="status-card" aria-label="Product status">
        <p class="mono">CURRENT PRODUCT STATUS</p>
        <p>
          This content covers <a href={product.releasesUrl}>{product.currentRelease}</a>, a
          {' '}{product.releaseStatus}. Stable-release platform acceptance is still in progress, and
          pre-1.0 interfaces or formats may change.
        </p>
      </aside>

      <div class="article-column">
        {
          kind === 'guide' && guideHowToSteps.length > 0 && (
            <section class="guide-contract" aria-labelledby="guide-prerequisites">
              <p class="mono">BEFORE YOU START</p>
              <h2 id="guide-prerequisites">Prerequisites</h2>
              <ul>
                {guidePrerequisites.map((prerequisite) => <li>{prerequisite}</li>)}
              </ul>

              <h2>Steps at a glance</h2>
              <p>
                Allow about {estimatedTaskMinutes} minutes after the prerequisites are ready.
                Network speed, storage configuration, or agent setup can extend that estimate.
              </p>
              <ol>
                {guideHowToSteps.map((step) => (
                  <li>
                    <a href={`#${step.anchor}`}>{step.name}</a>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>

              <p class="schema-note">
                This visible sequence is also published as truthful <code>HowTo</code>{' '}
                structured data. Valid structured data can help machines understand the page,
                but it does not guarantee a rich result. Google{' '}
                <a href="https://developers.google.com/search/blog/2023/08/howto-faq-changes">
                  retired How-to rich results
                </a>{' '}
                in 2023; the markup remains a Schema.org description for systems that consume it.
              </p>
            </section>
          )
        }

        <div class="prose prose-rein max-w-none">
          <slot />
        </div>

        <section class="related" aria-labelledby="related-content">
          <p class="mono">CONTINUE READING</p>
          <h2 id="related-content">Related Reinstate resources</h2>
          <nav aria-label="Related content">
            {
              related.map((item) => (
                <a href={item.path}>
                  <span>{item.title}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ))
            }
          </nav>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .editorial-page {
    border-bottom: 1px solid var(--rule);
  }

  .editorial-shell {
    width: min(100% - clamp(2.5rem, 8vw, 6rem), 72rem);
    margin-inline: auto;
  }

  .editorial-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }

  .eyebrow {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0.9rem;
    color: var(--prim-deep);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.5rem, 6.5vw, 5.25rem);
    line-height: 1;
    text-wrap: balance;
  }

  .direct-answer {
    max-width: 67ch;
    margin: clamp(1.35rem, 3vw, 2rem) 0 0;
    color: var(--ink-2);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
    border-block: 1px solid var(--rule);
  }

  .article-meta div {
    min-width: 9rem;
    padding: 0.9rem 1.25rem 0.9rem 0;
  }

  .article-meta div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .article-meta dt {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-meta dd {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .article-meta a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .status-card {
    position: sticky;
    top: 6.5rem;
    padding: 1.15rem;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--prim-deep);
    border-radius: 10px;
    background: var(--paper-2);
    color: var(--ink-2);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .status-card p {
    margin: 0;
  }

  .status-card p + p {
    margin-top: 0.65rem;
  }

  .status-card a {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .article-column {
    min-width: 0;
    max-width: 48rem;
  }

  .guide-contract {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--prim-deep);
    border-radius: 10px;
    background: var(--paper-2);
  }

  .guide-contract > .mono {
    margin: 0;
    color: var(--prim-deep);
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.09em;
  }

  .guide-contract h2 {
    margin: 1.25rem 0 0.75rem;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.8vw, 1.8rem);
  }

  .guide-contract > p:not(.mono, .schema-note) {
    margin: 0 0 0.85rem;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .guide-contract ul,
  .guide-contract ol {
    margin: 0;
    padding-left: 1.35rem;
  }

  .guide-contract li + li {
    margin-top: 0.75rem;
  }

  .guide-contract a {
    color: var(--ink);
    font-weight: 650;
    text-underline-offset: 3px;
  }

  .guide-contract li p {
    margin: 0.25rem 0 0;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .schema-note {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .article-column :global(.prose > :first-child) {
    margin-top: 0;
  }

  .article-column :global(h2),
  .article-column :global(h3) {
    scroll-margin-top: 7rem;
  }

  .related {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .related > p {
    margin: 0;
    color: var(--prim-deep);
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.09em;
  }

  .related h2 {
    margin: 0.65rem 0 1rem;
    color: var(--ink);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
  }

  .related nav {
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .related a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 0.93rem;
    text-decoration: none;
  }

  .related a:hover {
    color: var(--prim-deep);
  }

  @media (max-width: 760px) {
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .status-card {
      position: static;
    }

    .article-meta div {
      min-width: 50%;
    }

    .article-meta div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
