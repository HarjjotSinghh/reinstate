---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import { product } from '../data/product';

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  nofollow?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bare?: boolean;
}

const {
  title = product.defaultTitle,
  description = product.defaultDescription,
  canonical,
  ogImage,
  ogImageAlt,
  type = 'website',
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd = [],
  bare = false,
} = Astro.props;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e4e7dd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2723" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={ogImage}
      imageAlt={ogImageAlt}
      type={type}
      noindex={noindex}
      nofollow={nofollow}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      tags={tags}
    />
    <JsonLd data={jsonLd} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    {bingSiteVerification && (
      <meta name="msvalidate.01" content={bingSiteVerification} />
    )}

    {/* Single SVG icon only — a parallel favicon.ico wins in some browsers and never swaps with theme. */}
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <link rel="apple-touch-icon" href="/favicon-dark.svg" />

    {/* Light is default. Only apply dark when explicitly stored. Favicon follows theme. */}
    <script is:inline>
      (function () {
        /**
         * Browsers ignore href changes on existing <link rel=icon>.
         * Replace the node so the tab icon actually updates.
         */
        window.__reinSetFavicon = function (dark) {
          try {
            var href =
              (dark ? '/favicon-dark.svg' : '/favicon-light.svg') +
              '?v=3&t=' +
              Date.now();
            document
              .querySelectorAll(
                'link[rel="icon"], link[rel="shortcut icon"]'
              )
              .forEach(function (el) {
                el.parentNode && el.parentNode.removeChild(el);
              });
            var link = document.createElement('link');
            link.id = 'favicon';
            link.rel = 'icon';
            link.type = 'image/svg+xml';
            link.href = href;
            document.head.appendChild(link);
          } catch (e) {
            /* ignore */
          }
        };

        try {
          var stored = localStorage.getItem('rein-theme');
          var dark = stored === 'dark';
          if (dark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
          window.__reinSetFavicon(dark);
        } catch (e) {
          /* private mode */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    {!bare && <a class="skip-link" href="#main-content">Skip to content</a>}
    {!bare && <Header />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <Analytics />
  </body>
</html>
