---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/posthog.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bare?: boolean;
}

const {
  title = 'Reinstate — restore your AI coding workspace on any device',
  description =
    'Sessions, MCP servers, skills, and settings across every coding agent and every machine you own. Encrypted so only you can read it.',
  ogImage = '/brand/og.png',
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://reinstate.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4e7dd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2723" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {/* Single SVG icon only — a parallel favicon.ico wins in some browsers and never swaps with theme. */}
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <link rel="apple-touch-icon" href="/favicon-dark.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://reinstate.dev')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <PostHog />

    {/* Light is default. Only apply dark when explicitly stored. Favicon follows theme. */}
    <script is:inline>
      (function () {
        /**
         * Browsers ignore href changes on existing <link rel=icon>.
         * Replace the node so the tab icon actually updates.
         */
        window.__reinSetFavicon = function (dark) {
          try {
            var href =
              (dark ? '/favicon-dark.svg' : '/favicon-light.svg') +
              '?v=3&t=' +
              Date.now();
            document
              .querySelectorAll(
                'link[rel="icon"], link[rel="shortcut icon"]'
              )
              .forEach(function (el) {
                el.parentNode && el.parentNode.removeChild(el);
              });
            var link = document.createElement('link');
            link.id = 'favicon';
            link.rel = 'icon';
            link.type = 'image/svg+xml';
            link.href = href;
            document.head.appendChild(link);
          } catch (e) {
            /* ignore */
          }
        };

        try {
          var stored = localStorage.getItem('rein-theme');
          var dark = stored === 'dark';
          if (dark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
          window.__reinSetFavicon(dark);
        } catch (e) {
          /* private mode */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
