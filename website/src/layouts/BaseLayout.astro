---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bare?: boolean;
}

const {
  title = 'Reinstate — restore your AI coding workspace on any device',
  description =
    'Sessions, MCP servers, skills, and settings across every coding agent and every machine you own. Encrypted so only you can read it.',
  ogImage = '/brand/banner.svg',
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://reinstate.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4e7dd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2723" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://reinstate.dev')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    {/* Light is default. Only apply dark when explicitly stored. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('rein-theme');
          if (stored === 'dark') document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        } catch (e) {
          /* private mode */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    {!bare && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
