---
export const prerender = true;

import BaseLayout from './BaseLayout.astro';
import { getOrderedDocs, docSlug, docTitle } from '../lib/docs';
import {
  breadcrumbSchema,
  techArticleSchema,
  webPageSchema,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  updatedAt: Date | string;
  tags?: string[];
  noindex?: boolean;
  article?: boolean;
}

const {
  title,
  description,
  path: canonicalPath,
  updatedAt,
  tags = [],
  noindex = false,
  article = true,
} = Astro.props;
const docs = await getOrderedDocs();
const path = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const updatedDate = updatedAt instanceof Date ? updatedAt : new Date(updatedAt);
const isDocsIndex = canonicalPath === '/docs';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Docs', path: '/docs' },
  ...(!isDocsIndex ? [{ name: title, path: canonicalPath }] : []),
];
const jsonLd = [
  article
    ? techArticleSchema({
        path: canonicalPath,
        title,
        description,
        updatedAt: updatedDate,
        tags,
      })
    : webPageSchema({
        path: canonicalPath,
        title,
        description,
        updatedAt: updatedDate,
      }),
  breadcrumbSchema(breadcrumbs),
];
---

<BaseLayout
  title={`${title} · Reinstate Docs`}
  description={description}
  canonical={canonicalPath}
  type={article ? 'article' : 'website'}
  noindex={noindex}
  modifiedTime={article ? updatedDate : undefined}
  section={article ? 'Documentation' : undefined}
  tags={tags}
  jsonLd={jsonLd}
>
  <div class="shell docs">
    <aside class="side">
      <nav aria-label="Documentation">
        <p class="side-label mono">Documentation</p>
        <ul>
          {
            docs.map((entry) => {
              const href = `/docs/${docSlug(entry)}`;
              const active = path === href;
              return (
                <li>
                  <a href={href} class:list={[active && 'is-active']}>
                    {docTitle(entry)}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <a class="wait" href="/#join">Join waitlist</a>
      </nav>
    </aside>

    <div class="body">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {
            breadcrumbs.map((item, index) => {
              const current = index === breadcrumbs.length - 1;
              return (
                <li>
                  {current ? (
                    <span aria-current="page">{item.name}</span>
                  ) : (
                    <a href={item.path}>{item.name}</a>
                  )}
                </li>
              );
            })
          }
        </ol>
      </nav>
      <div class="mobile-nav">
        {
          docs.map((entry) => (
            <a href={`/docs/${docSlug(entry)}`}>{docTitle(entry)}</a>
          ))
        }
      </div>
      <article class="prose prose-rein max-w-3xl">
        <header class="doc-heading">
          <h1>{title}</h1>
          <p class="updated">
            Updated <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </p>
        </header>
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .docs {
    display: flex;
    gap: 2.5rem;
    padding-block: 2.5rem 4rem;
  }
  .side {
    display: none;
    width: 14rem;
    flex: none;
  }
  @media (min-width: 1024px) {
    .side {
      display: block;
    }
  }
  .side nav {
    position: sticky;
    top: 5.5rem;
  }
  .side-label {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .side a {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink-2);
    transition: background 0.15s, color 0.15s;
  }
  .side a:hover,
  .side a.is-active {
    background: var(--paper-2);
    color: var(--ink);
  }
  .wait {
    display: inline-block !important;
    margin-top: 1.5rem;
    font-size: 0.88rem !important;
    font-weight: 550;
    color: var(--prim-deep) !important;
    padding-left: 0.55rem;
  }
  .body {
    min-width: 0;
    flex: 1;
  }
  .breadcrumbs {
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
  }
  .breadcrumbs li + li::before {
    content: '/';
    margin-inline: 0.55rem;
    color: var(--rule);
  }
  .breadcrumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--prim-deep);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .doc-heading {
    margin-bottom: 1.35rem;
  }
  .doc-heading h1 {
    margin-bottom: 0.45rem;
  }
  .updated {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.8rem;
  }
  .mobile-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1024px) {
    .mobile-nav {
      display: none;
    }
  }
  .mobile-nav a {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 0.78rem;
    color: var(--ink-2);
    text-decoration: none;
  }
</style>
