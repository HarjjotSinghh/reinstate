---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroExploded from '../components/landing/HeroExploded.astro';
import ProblemExploded from '../components/landing/ProblemExploded.astro';
import TerminalProof from '../components/landing/TerminalProof.astro';
import SecurityExploded from '../components/landing/SecurityExploded.astro';
import { product } from '../data/product';
import { homepageSchema } from '../lib/schema';
---

<BaseLayout
  title={product.defaultTitle}
  description={product.defaultDescription}
  jsonLd={homepageSchema()}
>
  <HeroExploded />
  <ProblemExploded>
    <TerminalProof />
    <SecurityExploded />
  </ProblemExploded>
</BaseLayout>
