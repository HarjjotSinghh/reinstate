---
export const prerender = true;
import '@fontsource-variable/funnel-display';
import PreviewLayout from '../../layouts/PreviewLayout.astro';

/* ---------- build-time axonometric projector ---------- */
const CX = Math.cos(Math.PI / 6);
const P = (x: number, y: number, z: number): [number, number] => [(x - y) * CX, (x + y) * 0.5 - z];
const fmt = (pts: [number, number][]) => pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');

function box(x: number, y: number, z: number, w: number, d: number, h: number) {
  const A = P(x, y, z + h);
  const B = P(x + w, y, z + h);
  const C = P(x + w, y + d, z + h);
  const D = P(x, y + d, z + h);
  const B0 = P(x + w, y, z);
  const C0 = P(x + w, y + d, z);
  const D0 = P(x, y + d, z);
  return {
    top: fmt([A, B, C, D]),
    front: fmt([D, C, C0, D0]),
    side: fmt([B, C, C0, B0]),
  };
}

/* ---- act 1 · the desk ---- */
const desk = {
  top: box(0, 0, -16, 330, 195, 16),
  legs: [
    box(18, 18, -132, 18, 18, 116),
    box(294, 18, -132, 18, 18, 116),
    box(18, 159, -132, 18, 18, 116),
    box(294, 159, -132, 18, 18, 116),
  ],
};
const monitor = box(0, 34, 10, 18, 118, 124);
const monitorFoot = box(-4, 66, 0, 30, 54, 10);
const tower = box(78, 36, 0, 176, 126, 42);
const streams = [
  { key: 'sessions', tone: 'a' },
  { key: 'mcp', tone: 'b' },
  { key: 'skills', tone: 'c' },
  { key: 'settings', tone: 'd' },
].map((s, i) => ({ ...s, g: box(84 + i * 16, 44, 54 + i * 62, 160, 108, 15) }));
const mug = box(252, 152, 0, 30, 30, 34);
const board = box(96, 176, 0, 150, 40, 9);

/* ---- act 2 · the sealed object ---- */
const crateBig = box(0, 0, -96, 148, 148, 96);
const crateSmall = box(26, 26, 0, 96, 96, 58);
const seal = box(14, 14, 122, 120, 120, 120);

/* ---- act 3 · the couch table ---- */
const table = {
  top: box(0, 0, -16, 248, 186, 16),
  legs: [
    box(16, 16, -130, 16, 16, 114),
    box(216, 16, -130, 16, 16, 114),
    box(16, 154, -130, 16, 16, 114),
    box(216, 154, -130, 16, 16, 114),
  ],
};
const deck = box(24, 30, 0, 196, 126, 18);
const lidBack = box(38, 8, 18, 178, 13, 66);
const restacked = ['a', 'b', 'c', 'd'].map((tone, i) => ({
  tone,
  g: box(40, 38, 30 + i * 16, 160, 108, 15),
}));

/* ---- props ---- */
const pot = box(0, 0, -74, 76, 76, 74);
const stack = [box(0, 0, -102, 130, 130, 34), box(8, 10, -68, 118, 116, 30), box(4, 6, -38, 126, 122, 26)];

const legend = [
  { key: 'sessions', tone: 'a', note: 'threads and dead ends' },
  { key: 'mcp', tone: 'b', note: 'servers, args, env' },
  { key: 'skills', tone: 'c', note: 'the ones you wrote' },
  { key: 'settings', tone: 'd', note: 'per agent, per project' },
];

const SK = 'var(--sv-stroke)';
const INK = 'var(--sv-ink)';
const DIM = 'var(--sv-dim)';
const PRIM = 'var(--sv-prim)';
const PRIM_DEEP = 'var(--sv-prim-deep)';
---

