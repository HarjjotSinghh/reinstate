        {/* ---------- ACT 2 · sealed ---------- */}
        <g transform="translate(866 452) scale(1.02)">
          <g class="unit furn">
            <polygon class="f-side" points={crateBig.side} />
            <polygon class="f-front" points={crateBig.front} />
            <polygon class="f-top" points={crateBig.top} />
