            <polygon class="f-side" points={deck.side} />
            <polygon class="f-front" points={deck.front} />
            <polygon class="f-top" points={deck.top} />
          </g>
          {
            restacked.map((s, i) => (
              <g class={`unit tray back t-${s.tone}`} style={`--i:${i}`}>
