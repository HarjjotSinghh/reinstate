---
export const prerender = true;
import '@fontsource-variable/bricolage-grotesque';
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const ARC = 'M 352 208 C 520 40, 980 40, 1146 262';
const parcels = [
  { label: 'sessions', d: '0s' },
  { label: 'mcp', d: '1.1s' },
  { label: 'skills', d: '2.2s' },
  { label: 'settings', d: '3.3s' },
];
---

<PreviewLayout title="4 · Night shift — Reinstate" themeColor="#0d1418">
  <div class="page">
    <header class="nav">
      <a href="/" class="mark"><span class="glyph" aria-hidden="true"></span> reinstate</a>
      <nav class="links">
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/architecture">Architecture</a>
        <a href="/docs/security-model">Security</a>
        <a href="https://github.com/HarjjotSinghh/reinstate" rel="noopener noreferrer" target="_blank">GitHub</a>
      </nav>
      <a class="navcta" href="#join">Join the waitlist</a>
    </header>

    <main>
      <div class="lede">
        <span class="badge"><i aria-hidden="true"></i> 23:41 desktop &rarr; 23:47 laptop</span>
        <h1>Restore your AI coding workspace on any device</h1>
        <p class="sub">
          Sessions, MCP servers, skills, and settings, across every coding agent and
          every machine you own. Encrypted so only you can read it.
        </p>
        <form class="join" id="join" onsubmit="event.preventDefault()">
          <label class="sr" for="n-email">Email address</label>
          <input id="n-email" type="email" placeholder="you@yourdomain.dev" autocomplete="email" />
          <button type="submit">Join the waitlist</button>
        </form>
        <p class="micro">Sealed with age · stored in your bucket · Apache&#8209;2.0</p>
      </div>
    </main>

    <figure class="scene" aria-labelledby="ntitle">
      <p id="ntitle" class="sr">
        A desk at night with a glowing monitor, and a laptop open on a couch across the room,
        with four streams of context arcing between them.
      </p>

      <svg class="art" viewBox="0 0 1440 470" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
        <defs>
          <linearGradient id="lampcone" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffdf6b" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#ffdf6b" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="screenglow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#c6ff52" stop-opacity="0.95" />
            <stop offset="100%" stop-color="#77cf2f" stop-opacity="0.8" />
          </linearGradient>
          <radialGradient id="floorglow" cx="50%" cy="50%">
            <stop offset="0%" stop-color="#b8ff3c" stop-opacity="0.14" />
            <stop offset="100%" stop-color="#b8ff3c" stop-opacity="0" />
          </radialGradient>
        </defs>

        {/* window + skyline */}
        <g class="window">
          <rect x="62" y="58" width="176" height="188" rx="4" />
          <line x1="150" y1="58" x2="150" y2="246" />
          <line x1="62" y1="152" x2="238" y2="152" />
          <g class="city">
            <rect x="78" y="196" width="16" height="34" />
            <rect x="102" y="176" width="12" height="54" />
            <rect x="122" y="206" width="18" height="24" />
            <rect x="164" y="186" width="14" height="44" />
            <rect x="186" y="204" width="20" height="26" />
            <rect x="212" y="190" width="12" height="40" />
          </g>
          <g class="stars">
            <circle cx="96" cy="92" r="1.8" />
            <circle cx="196" cy="78" r="1.4" />
            <circle cx="214" cy="120" r="1.6" />
            <circle cx="112" cy="128" r="1.3" />
          </g>
        </g>

        {/* left: desk */}
        <ellipse class="glow" cx="320" cy="404" rx="230" ry="44" fill="url(#floorglow)" />
        <g class="desk">
          <rect class="top" x="128" y="336" width="404" height="13" rx="4" />
          <rect class="leg" x="146" y="349" width="12" height="66" rx="4" />
          <rect class="leg" x="502" y="349" width="12" height="66" rx="4" />
          <rect class="chair" x="560" y="298" width="26" height="118" rx="12" />
          <rect class="chair" x="556" y="286" width="86" height="24" rx="12" />

          <polygon class="cone" points="404,178 470,178 520,336 348,336" fill="url(#lampcone)" />
          <g class="lamp">
            <rect x="430" y="196" width="12" height="140" rx="5" />
            <path d="M400 190 h72 l-14 -22 h-44 z" />
            <rect x="404" y="330" width="64" height="9" rx="4" />
          </g>

          <g class="monitor">
            <rect class="bezel" x="196" y="192" width="212" height="134" rx="9" />
            <rect class="screen" x="206" y="202" width="192" height="114" rx="5" fill="url(#screenglow)" />
            <rect class="row" x="220" y="216" width="82" height="7" rx="3.5" />
            <rect class="row" x="220" y="232" width="132" height="7" rx="3.5" />
            <rect class="row" x="220" y="248" width="104" height="7" rx="3.5" />
            <rect class="row" x="220" y="264" width="146" height="7" rx="3.5" />
            <rect class="row" x="220" y="280" width="70" height="7" rx="3.5" />
            <rect class="neck" x="288" y="326" width="28" height="10" rx="4" />
          </g>

          <g class="mug">
            <rect x="150" y="308" width="26" height="28" rx="5" />
            <path d="M176 315 h9 a7 7 0 0 1 0 14 h-9" />
            <path class="steam" d="M158 300 c4 -6 -4 -10 0 -16 M168 300 c4 -6 -4 -10 0 -16" />
          </g>
          <rect class="board" x="222" y="330" width="150" height="8" rx="4" />
        </g>
        <text class="tag" x="330" y="452">desktop · lid closes at 23:41</text>

        {/* right: couch + laptop */}
        <ellipse class="glow" cx="1140" cy="410" rx="220" ry="42" fill="url(#floorglow)" />
        <g class="couch">
          <rect class="seat" x="968" y="336" width="360" height="52" rx="18" />
          <rect class="back" x="1230" y="256" width="98" height="88" rx="20" />
          <rect class="arm" x="944" y="308" width="40" height="80" rx="18" />
          <rect class="leg" x="998" y="388" width="12" height="26" rx="4" />
          <rect class="leg" x="1286" y="388" width="12" height="26" rx="4" />
        </g>
        <g class="laptop">
          <path class="lidface" d="M1058 336 L1078 244 h140 l6 92 z" />
          <path class="lidglow" d="M1068 330 L1085 252 h128 l5 78 z" fill="url(#screenglow)" />
          <path class="base" d="M1032 336 h222 l16 20 h-254 z" />
        </g>
        <text class="tag" x="1150" y="452">laptop · opens at 23:47</text>

        {/* arc */}
        <path class="arc" d={ARC} />
      </svg>

      <div class="parcels" aria-hidden="true">
        {
          parcels.map((p) => (
            <span class="parcel" style={`--d:${p.d}`}>
              {p.label}
            </span>
          ))
        }
      </div>
    </figure>
  </div>
</PreviewLayout>

<style>
  .page {
    --night: oklch(0.185 0.028 235);
    --night-2: oklch(0.235 0.03 235);
    --ink: oklch(0.97 0.008 235);
    --muted: oklch(0.76 0.014 235);
    --dim: oklch(0.58 0.016 235);
    --edge: oklch(0.34 0.024 235);
    --prim: oklch(0.88 0.21 128);
    --prim-ink: oklch(0.2 0.05 128);
    --lamp: oklch(0.9 0.16 100);

    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(ellipse 70% 46% at 50% 100%, oklch(0.27 0.035 235), transparent 70%),
      var(--night);
    color: var(--ink);
    overflow-x: clip;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 84rem;
    width: 100%;
    margin-inline: auto;
    padding: 1.35rem clamp(1.25rem, 4vw, 3rem);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Bricolage Grotesque Variable', ui-sans-serif, sans-serif;
    font-variation-settings: 'wdth' 88;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .glyph {
    width: 19px;
    height: 19px;
    border-radius: 6px;
    background: var(--prim);
    box-shadow: inset 0 0 0 4px var(--night);
  }
  .links {
    display: flex;
    gap: 1.4rem;
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .links a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--ink);
  }
  .navcta {
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    background: var(--prim);
    color: var(--prim-ink);
    font-size: 0.875rem;
    font-weight: 570;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), filter 0.2s;
  }
  .navcta:hover {
    filter: brightness(1.07);
  }
  .navcta:active {
    transform: scale(0.97);
  }
  @media (max-width: 900px) {
    .links {
      display: none;
    }
    .navcta {
      margin-left: auto;
    }
  }

  main {
    max-width: 84rem;
    width: 100%;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem) 0;
  }
  .lede {
    max-width: 42rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.85rem 0.34rem 0.7rem;
    border: 1px solid var(--edge);
    border-radius: 999px;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.74rem;
    color: var(--muted);
  }
  .badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--prim);
    box-shadow: 0 0 0 3px oklch(0.88 0.21 128 / 0.2);
  }

  h1 {
    margin: clamp(1.1rem, 2.5vw, 1.6rem) 0 0;
    max-width: 15ch;
    font-family: 'Bricolage Grotesque Variable', ui-sans-serif, sans-serif;
    font-variation-settings: 'wdth' 84;
    font-size: clamp(2.5rem, 6.2vw, 5.2rem);
    line-height: 0.97;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
    animation: rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .sub {
    margin: 1.2rem 0 0;
    max-width: 48ch;
    font-size: clamp(1rem, 0.5vw + 0.92rem, 1.15rem);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
    animation: rise 0.85s 0.09s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .join {
    margin-top: clamp(1.6rem, 3vw, 2.2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 28rem;
    animation: rise 0.85s 0.17s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .join input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.76rem 0.95rem;
    border: 1px solid var(--edge);
    border-radius: 10px;
    background: oklch(0.235 0.03 235 / 0.7);
    color: var(--ink);
    font-size: 0.93rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .join input::placeholder {
    color: var(--dim);
  }
  .join input:focus {
    outline: none;
    border-color: var(--prim);
    background: var(--night-2);
  }
  .join button {
    padding: 0.76rem 1.25rem;
    border: none;
    border-radius: 10px;
    background: var(--prim);
    color: var(--prim-ink);
    font-size: 0.93rem;
    font-weight: 570;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.13s cubic-bezier(0.16, 1, 0.3, 1), filter 0.2s;
  }
  .join button:hover {
    filter: brightness(1.07);
  }
  .join button:active {
    transform: scale(0.97);
  }

  .micro {
    margin: 0.9rem 0 0;
    font-size: 0.79rem;
    color: var(--dim);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Scene */
  .scene {
    position: relative;
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    width: 100%;
  }
  .art {
    display: block;
    width: 100%;
    height: auto;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    animation: rise 1s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .window rect,
  .window line {
    fill: none;
    stroke: var(--edge);
    stroke-width: 2;
  }
  .window > rect:first-child {
    fill: oklch(0.22 0.03 240);
  }
  .city rect {
    fill: oklch(0.28 0.03 240);
    stroke: none;
  }
  .stars circle {
    fill: oklch(0.8 0.03 235);
    stroke: none;
    opacity: 0.7;
  }

  .desk .top,
  .desk .leg,
  .desk .chair,
  .board,
  .neck,
  .mug rect {
    fill: oklch(0.3 0.028 235);
  }
  .lamp rect,
  .lamp path {
    fill: oklch(0.34 0.03 235);
  }
  .mug path {
    fill: none;
    stroke: oklch(0.3 0.028 235);
    stroke-width: 4;
  }
  .steam {
    stroke: oklch(0.5 0.02 235) !important;
    stroke-width: 2.4 !important;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .bezel {
    fill: oklch(0.26 0.028 235);
  }
  .monitor .row {
    fill: oklch(0.24 0.05 140);
    opacity: 0.55;
  }
  .monitor .row:nth-of-type(2n) {
    opacity: 0.4;
  }

  .couch rect {
    fill: oklch(0.28 0.03 245);
  }
  .couch .back {
    fill: oklch(0.31 0.032 245);
  }
  .laptop .lidface {
    fill: oklch(0.25 0.028 235);
  }
  .laptop .base {
    fill: oklch(0.3 0.028 235);
  }

  .tag {
    fill: var(--dim);
    font-size: 15px;
    text-anchor: middle;
  }

  .arc {
    fill: none;
    stroke: oklch(0.88 0.21 128 / 0.5);
    stroke-width: 2;
    stroke-dasharray: 6 8;
    animation: flow 3s linear infinite;
  }

  .parcels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .parcel {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.24rem 0.55rem;
    border-radius: 6px;
    background: var(--prim);
    color: var(--prim-ink);
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: clamp(0.6rem, 0.55vw, 0.76rem);
    font-weight: 500;
    white-space: nowrap;
    offset-path: path('M 352 208 C 520 40, 980 40, 1146 262');
    offset-rotate: 0deg;
    offset-anchor: 50% 50%;
    scale: calc(1 / 1440 * var(--w, 1440));
    animation: ride 4.6s linear infinite;
    animation-delay: var(--d);
  }

  @supports not (offset-path: path('M 0 0 L 1 1')) {
    .parcels {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parcel {
      offset-distance: 50%;
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .parcels {
      display: none;
    }
    .tag {
      font-size: 22px;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -28;
    }
  }
  @keyframes ride {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
</style>

<script>
  /* keep the offset-path parcels aligned with the responsive SVG viewBox */
  const scene = document.querySelector('.scene') as HTMLElement | null;
  const art = document.querySelector('.art') as SVGSVGElement | null;
  const wrap = document.querySelector('.parcels') as HTMLElement | null;

  if (scene && art && wrap) {
    const sync = () => {
      const r = art.getBoundingClientRect();
      const k = r.width / 1440;
      wrap.style.transformOrigin = '0 0';
      wrap.style.transform = `scale(${k})`;
      wrap.style.width = '1440px';
      wrap.style.height = '470px';
      wrap.style.top = `${art.offsetTop}px`;
    };
    sync();
    new ResizeObserver(sync).observe(art);
  }
</script>
