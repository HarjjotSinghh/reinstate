---
export const prerender = true;
import '@fontsource/young-serif';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import BrandLockup from '../../components/BrandLockup.astro';

const cards = [
  {
    repo: 'acme-api',
    agent: 'claude code',
    stamp: '23:41',
    lines: ['rejected: rewrite auth in middleware', 'keep: table-driven tests only', 'read: 14 files, do not re-read'],
  },
  {
    repo: 'infra-tf',
    agent: 'gemini cli',
    stamp: '23:38',
    lines: ['module boundary agreed', 'no remote state migration', 'plan output pending review'],
  },
  {
    repo: 'docs-site',
    agent: 'opencode',
    stamp: '23:12',
    lines: ['voice: concrete, no hype verbs', 'mdx frontmatter fixed', 'sidebar order locked'],
  },
];
---

<PreviewLayout title="3 · Vault — Reinstate" themeColor="#1b2b21">
  <div class="page">
    <header class="nav">
      <BrandLockup href="/" class="mark" size={22} />
      <nav class="links">
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/security-model">Security</a>
        <a href="https://github.com/HarjjotSinghh/reinstate" rel="noopener noreferrer" target="_blank">GitHub</a>
      </nav>
      <a class="navcta" href="#join">Join the waitlist</a>
    </header>

    <main class="stage">
      <div class="lede">
        <h1>Restore your AI coding workspace on any device</h1>
        <p class="sub">
          Sessions, MCP servers, skills, and settings, across every coding agent and
          every machine you own. Encrypted so only you can read it.
        </p>
        <form class="join" id="join" onsubmit="event.preventDefault()">
          <label class="sr" for="g-email">Email address</label>
          <input id="g-email" type="email" placeholder="you@yourdomain.dev" autocomplete="email" />
          <button type="submit">Join the waitlist</button>
        </form>
        <dl class="facts">
          <div><dt>Sealed with</dt><dd>age · x25519</dd></div>
          <div><dt>Stored in</dt><dd>your bucket</dd></div>
          <div><dt>Read by</dt><dd>you, only</dd></div>
        </dl>
      </div>

      <div class="deck" id="deck" aria-hidden="true">
        {
          cards.map((c, i) => (
            <article class={`card c${i}`} style={`--i:${i}`}>
              <header>
                <span class="repo">{c.repo}</span>
                <span class="stamp">{c.stamp}</span>
              </header>
              <ul>
                {c.lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              <footer>
                <span class="agent">{c.agent}</span>
                <span class="bars">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
              </footer>
              {i === 0 && (
                <span class="seal">
                  <svg viewBox="0 0 40 40" aria-hidden="true">
                    <path d="M13 18 v -4 a 7 7 0 0 1 14 0 v 4" />
                    <rect x="10" y="18" width="20" height="15" rx="4" />
                    <circle cx="20" cy="25" r="2" />
                  </svg>
                </span>
              )}
            </article>
          ))
        }
      </div>

      <p class="caption">
        One session, sealed on the desktop at 23:41, opened on the laptop at 23:47.
      </p>
    </main>
  </div>
</PreviewLayout>

<script>
  const deck = document.getElementById('deck');
  if (deck && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    let tx = 0;
    let ty = 0;

    const apply = () => {
      raf = 0;
      deck.style.setProperty('--mx', tx.toFixed(3));
      deck.style.setProperty('--my', ty.toFixed(3));
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        tx = (e.clientX / window.innerWidth - 0.5) * 2;
        ty = (e.clientY / window.innerHeight - 0.5) * 2;
        if (!raf) raf = requestAnimationFrame(apply);
      },
      { passive: true }
    );
  }
</script>

<style>
  .page {
    --bg: oklch(0.245 0.042 158);
    --bg-2: oklch(0.29 0.04 158);
    --bone: oklch(0.945 0.014 128);
    --bone-2: oklch(0.9 0.016 128);
    --bone-dim: oklch(0.72 0.02 150);
    --slate: oklch(0.33 0.03 158);
    --pine: oklch(0.19 0.035 158);
    --prim: oklch(0.87 0.21 128);

    position: relative;
    min-height: 100svh;
    background: var(--bg);
    color: var(--bone);
    overflow-x: clip;
    padding-bottom: 6rem;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 84rem;
    margin-inline: auto;
    padding: 1.4rem clamp(1.25rem, 4vw, 3rem);
  }
  .mark {
    font-family: 'Young Serif', ui-serif, Georgia, serif;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.4rem;
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--bone-dim);
  }
  .links a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--bone);
  }
  .navcta {
    padding: 0.52rem 1rem;
    border-radius: 999px;
    background: var(--prim);
    color: var(--pine);
    font-size: 0.865rem;
    font-weight: 570;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), filter 0.2s;
  }
  .navcta:hover {
    filter: brightness(1.07);
  }
  .navcta:active {
    transform: scale(0.97);
  }
  @media (max-width: 820px) {
    .links {
      display: none;
    }
    .navcta {
      margin-left: auto;
    }
  }

  .stage {
    position: relative;
    max-width: 84rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 1000px) {
    .stage {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  h1 {
    margin: 0;
    max-width: 13ch;
    font-family: 'Young Serif', ui-serif, Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4.9rem);
    line-height: 1.02;
    letter-spacing: -0.022em;
    font-weight: 400;
    text-wrap: balance;
    animation: rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .sub {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 0.5vw + 0.92rem, 1.15rem);
    line-height: 1.62;
    color: var(--bone-dim);
    text-wrap: pretty;
    animation: rise 0.85s 0.09s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .join {
    margin-top: clamp(1.75rem, 3vw, 2.4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 29rem;
    animation: rise 0.85s 0.17s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .join input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.78rem 0.95rem;
    border: 1px solid var(--slate);
    border-radius: 999px;
    background: oklch(0.29 0.04 158 / 0.6);
    color: var(--bone);
    font-size: 0.93rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .join input::placeholder {
    color: oklch(0.62 0.02 150);
  }
  .join input:focus {
    outline: none;
    border-color: var(--prim);
    background: oklch(0.29 0.04 158);
  }
  .join button {
    padding: 0.78rem 1.3rem;
    border: none;
    border-radius: 999px;
    background: var(--bone);
    color: var(--pine);
    font-size: 0.93rem;
    font-weight: 570;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.13s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  .join button:hover {
    background: var(--prim);
  }
  .join button:active {
    transform: scale(0.97);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.5rem, 3vw, 2.75rem);
    margin: clamp(2rem, 3.5vw, 2.75rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--slate);
    animation: rise 0.85s 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(0.6 0.02 150);
    margin-bottom: 0.3rem;
  }
  .facts dd {
    margin: 0;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.85rem;
    color: var(--bone);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Deck */
  .deck {
    --mx: 0;
    --my: 0;
    position: relative;
    height: clamp(21rem, 34vw, 27rem);
    perspective: 1400px;
  }

  .card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(23rem, 82vw);
    padding: 1.1rem 1.2rem 1rem;
    border-radius: 14px;
    background: var(--bone);
    color: var(--pine);
    box-shadow: 0 8px 28px oklch(0.14 0.03 158 / 0.45);
    transform:
      translate(-50%, -50%)
      translate(calc(var(--tx) + var(--mx) * var(--depth) * 14px), calc(var(--ty) + var(--my) * var(--depth) * 10px))
      rotate(var(--rot));
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    animation: deal 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.2s + var(--i) * 0.11s);
  }
  .c0 {
    --tx: 1.75rem;
    --ty: -3.2rem;
    --rot: 5.5deg;
    --depth: 1.6;
    z-index: 3;
  }
  .c1 {
    --tx: -0.5rem;
    --ty: 1.4rem;
    --rot: -2.5deg;
    --depth: 1;
    z-index: 2;
    background: var(--bone-2);
  }
  .c2 {
    --tx: -3.5rem;
    --ty: 5.6rem;
    --rot: -8deg;
    --depth: 0.5;
    z-index: 1;
    background: oklch(0.84 0.018 128);
  }

  .card header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid oklch(0.19 0.035 158 / 0.16);
  }
  .repo {
    font-family: 'Young Serif', ui-serif, Georgia, serif;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .stamp,
  .agent {
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.72rem;
    color: oklch(0.42 0.03 158);
  }

  .card ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }
  .card li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.83rem;
    line-height: 1.45;
    color: oklch(0.34 0.03 158);
  }
  .card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: oklch(0.62 0.16 132);
  }

  .card footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.95rem;
    padding-top: 0.7rem;
    border-top: 1px solid oklch(0.19 0.035 158 / 0.12);
  }
  .bars {
    display: flex;
    gap: 3px;
  }
  .bars i {
    width: 16px;
    height: 5px;
    border-radius: 2px;
    background: oklch(0.19 0.035 158 / 0.18);
  }
  .bars i:first-child {
    background: oklch(0.62 0.16 132);
  }

  .seal {
    position: absolute;
    top: -1.1rem;
    right: -1.1rem;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--prim);
    border: 3px solid var(--bone);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 12px oklch(0.14 0.03 158 / 0.35);
  }
  .seal svg {
    width: 60%;
    height: 60%;
    fill: none;
    stroke: var(--pine);
    stroke-width: 2.6;
    stroke-linecap: round;
  }
  .seal svg rect {
    fill: var(--pine);
    stroke: none;
  }
  .seal svg circle {
    fill: var(--prim);
    stroke: none;
  }

  .caption {
    grid-column: 1 / -1;
    margin: clamp(1.5rem, 4vw, 3rem) 0 0;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.78rem;
    color: oklch(0.62 0.02 150);
    text-align: center;
  }

  @media (max-width: 999px) {
    .deck {
      height: clamp(23rem, 62vw, 27rem);
    }
    .c0 {
      --tx: 2rem;
    }
    .c2 {
      --tx: -2rem;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes deal {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) translate(calc(var(--tx) - 2.5rem), calc(var(--ty) + 3rem)) rotate(calc(var(--rot) - 8deg));
    }
  }
</style>
