---
export const prerender = true;

import DocsLayout from '../../layouts/DocsLayout.astro';
import { getOrderedDocs, docSlug, docTitle, docDescription } from '../../lib/docs';

const docs = await getOrderedDocs();
---

<DocsLayout
  title="Documentation"
  description="Learn how to install Reinstate, sync Claude Code and Codex sessions, remap project paths, and keep credentials out of encrypted storage."
  path="/docs"
  updatedAt={new Date('2026-08-01')}
  tags={['reinstate', 'documentation', 'coding-agent-session-sync']}
  article={false}
>
  <p>
    Reinstate's stable v0.2.0 CLI finds local Claude Code, Codex, Gemini CLI,
    and OpenCode sessions without configuration. It also syncs same-vendor Claude Code and
    Codex sessions between devices through client-side-encrypted S3-compatible storage.
    Universal configuration and cross-agent handoffs remain roadmap work.
  </p>
  <p>
    Prefer the short CLI alias <code>rein</code>. Full name <code>reinstate</code> is the same binary.
  </p>

  <h2>Guides</h2>
  <ul>
    {
      docs.map((entry) => (
        <li>
          <a href={`/docs/${docSlug(entry)}`}>{docTitle(entry)}</a>
          {` — ${docDescription(entry)}`}
        </li>
      ))
    }
  </ul>
</DocsLayout>
