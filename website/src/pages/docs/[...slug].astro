---
export const prerender = true;

import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  getOrderedDocs,
  getDocBySlug,
  docSlug,
  docTitle,
  docDescription,
} from '../../lib/docs';
import { extractFaqEntries } from '../../lib/faq';
import { faqPageSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const docs = await getOrderedDocs();
  return docs.map((entry) => ({
    params: { slug: docSlug(entry) },
  }));
}

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/docs');
}

const entry = await getDocBySlug(slug);
if (!entry) {
  return Astro.redirect('/docs');
}

const { Content } = await render(entry);
const title = docTitle(entry);
const description = docDescription(entry);
const path = `/docs/${docSlug(entry)}`;
const extraJsonLd =
  slug === 'faq'
    ? faqPageSchema(path, extractFaqEntries(entry.body ?? ''))
    : [];
---

<DocsLayout
  title={title}
  description={description}
  path={path}
  author={entry.data.author}
  status={entry.data.status}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  noindex={entry.data.noindex}
  {extraJsonLd}
>
  <Content />
</DocsLayout>
