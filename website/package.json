    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/questrial": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "esbuild": "^0.28.1",
    "motion": "^12.42.2",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vitest": "^4.1.11"
