{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-static-build.mjs",
    "astro": "astro",
    "indexnow": "node scripts/indexnow.mjs",
    "generate:media": "node scripts/generate-responsive-media.mjs",
    "generate:og-art": "node scripts/generate-og-art-variants.mjs",
    "generate:github-social": "tsx scripts/generate-github-social.ts",
    "generate:research-diagrams": "node scripts/generate-rebuilt-diagrams.mjs",
    "check:media": "node scripts/generate-responsive-media.mjs --check",
    "check:github-social": "tsx scripts/generate-github-social.ts --check",
    "check:path-visualizer": "node scripts/check-path-visualizer.mjs",
    "test": "vitest run && npm run test:seo && npm run test:links && npm run test:performance && npm run test:indexnow && npm run test:preview && npm run test:freshness && npm run test:lighthouse && npm run test:production-discovery && npm run test:agent-surface && npm run check:media && npm run check:github-social",
    "test:seo": "node --test scripts/check-seo.node-test.mjs",
    "test:links": "node --test scripts/check-links.node-test.mjs",
    "test:performance": "node --test scripts/check-performance.node-test.mjs",
    "test:indexnow": "node --test scripts/indexnow.node-test.mjs",
    "test:preview": "node --test scripts/serve-static-build.node-test.mjs",
    "test:freshness": "node --test scripts/check-freshness.node-test.mjs",
    "test:lighthouse": "node --test scripts/lighthouse-smoke.node-test.mjs",
    "test:production-discovery": "node --test scripts/check-production-discovery.node-test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:indexnow": "node scripts/indexnow.mjs --current dist/client/sitemap-index.xml --previous dist/client/sitemap-index.xml",
    "check:freshness": "node scripts/check-freshness.mjs",
    "check:lighthouse": "node scripts/lighthouse-smoke.mjs",
    "check:production-discovery": "node scripts/check-production-discovery.mjs",
    "test:watch": "vitest",
    "check:agent-surface": "node scripts/check-agent-surface.mjs",
    "test:agent-surface": "node --test scripts/check-agent-surface.node-test.mjs"
  },
  "dependencies": {
